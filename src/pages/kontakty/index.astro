---
import Page from '../../layouts/Page.astro';
import Tape from '../../components/Tape.astro';
import RoundLabel from '../../components/RoundLabel.astro';
import { site, halls, visitFaq, google } from '../../data/site';
import { isTodo, link } from '../../lib/util';
import { schedule } from '../../data/schedule';

const hall = halls[0];
const enc = encodeURIComponent;
const toMin = (t: string) => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
const fmt = (m: number) => `${String(Math.floor(m / 60)).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
// Club hours come from the training schedule: each day's sessions merged into time windows
const sessions = schedule.flatMap((t) => t.groups.map((g) => ({ name: g.name, days: g.days, from: toMin(g.from), to: toMin(g.to) })));
const windows = [1, 2, 3, 4, 5, 6, 7].map((d) => {
  const list = sessions.filter((s) => s.days.includes(d)).map((s) => [s.from, s.to]).sort((a, b) => a[0] - b[0]);
  const out: number[][] = [];
  list.forEach(([a, b]) => { const last = out[out.length - 1]; if (last && a <= last[1]) last[1] = Math.max(last[1], b); else out.push([a, b]); });
  return out;
});
const dayText = (d: number) => windows[d].length ? windows[d].map(([a, b]) => `${fmt(a)}–${fmt(b)}`).join(', ') : 'Вихідний';
const week = ['Понеділок', 'Вівторок', 'Середа', 'Четвер', 'Пʼятниця', 'Субота', 'Неділя'];
const modes = [
  { id: 'driving', label: 'Авто' },
  { id: 'transit', label: 'Транспорт' },
  { id: 'walking', label: 'Пішки' },
];
const dir = (mode: string) => `https://www.google.com/maps/dir/?api=1&destination=${enc(hall.query)}&travelmode=${mode}`;
---
<Page
  title="Контакти боксерського клубу «Світ Боксу» у Броварах"
  description="Школа боксу «Світ Боксу» у Броварах: спорткомплекс «Манеж», вул. Героїв України, 30. Просторий і світлий зал, зручне розташування. Тел. +38 (073) 721 71 71."
  current="kontakty/"
  kicker="Контакти"
  heading="Школа боксу у Броварах «Світ Боксу»"
  lead="Зал у спорткомплексі «Манеж» у Броварах. Подзвоніть — підберемо групу під ваш графік."
>
  <div slot="head" class="call-card">
    <span class="open-state mono"><i aria-hidden="true"></i><span>Тренування з понеділка по пʼятницю</span></span>
    <a class="call-num" href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
    <div class="call-row">
      <button type="button" class="link" data-copy={site.phone.display} data-done="Номер скопійовано ✓">Копіювати номер</button>
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>

  <!-- Full-bleed dark map with a floating gym card (store-locator pattern) -->
  <section class="mapx" id={hall.id} aria-label="Зал на карті">
    <div class="mapx-map gated">
      <div class="map-gate" id="mapGate">
        <p class="mono muted">Карта Google встановлює cookie Google</p>
        <button type="button" class="btn" id="mapAllow"><span>Показати карту</span><span class="arr">→</span></button>
        <a class="link-inline mono" href={`https://www.google.com/maps/search/?api=1&query=${enc(hall.query)}`} target="_blank" rel="noopener">Відкрити в Google Maps ↗</a>
      </div>
      <iframe title={`Карта: ${hall.name}, ${hall.address}`} referrerpolicy="no-referrer-when-downgrade" tabindex="-1"
        data-src={`https://maps.google.com/maps?q=${enc(hall.query)}&z=16&hl=uk&output=embed`}></iframe>
      <span class="radar" aria-hidden="true"><i></i><i></i><i></i></span>
      <button type="button" class="map-shield" id="mapShield"><span class="mono">Натисніть, щоб рухати карту</span></button>
    </div>

    <div class="wrap mapx-wrap">
      <article class="gym-card">
        <span class="corner mono"><i aria-hidden="true"></i>{hall.corner} · Бровари</span>
        <h2>{hall.address}</h2>
        <p class="gym-name">{hall.name}</p>
        <a class="gym-rate mono" href={google.url} target="_blank" rel="noopener"><b>★ {google.rating}</b> · {google.count} відгуків у Google ↗</a>
        <p class="open-state big mono"><i aria-hidden="true"></i><span>Тренування з понеділка по пʼятницю</span></p>

        <ol class="week mono" aria-label="Години тренувань клубу" data-sessions={JSON.stringify(sessions)}>
          {week.map((d, i) => <li data-dow={i + 1} class:list={[{ off: !windows[i].length }]}><span>{d}</span><span>{dayText(i)}</span></li>)}
        </ol>
        <a class="mono week-link" href={link('rozklad/')}>Розклад груп →</a>

        <div class="route">
          <div class="modes" role="radiogroup" aria-label="Як добиратись">
            {modes.map((m, i) => (
              <button type="button" role="radio" class="mono" data-mode={m.id} data-href={dir(m.id)} aria-checked={i === 0 ? 'true' : 'false'}>{m.label}</button>
            ))}
          </div>
          <a class="btn" id="routeBtn" href={dir('driving')} target="_blank" rel="noopener"><span>Прокласти маршрут</span><span class="arr">↗</span></a>
          <button type="button" class="link" data-copy={`Бровари, ${hall.address}, ${hall.name}`} data-done="Адресу скопійовано ✓">Копіювати адресу</button>
        </div>
      </article>
    </div>
  </section>

  <section class="blk">
    <div class="wrap">
      <RoundLabel n="Раунд 01" label="Дорога" />
      <h2 class="h2" data-punch>Як дістатись</h2>
      <ol class="get-here m-rail">
        {hall.getHere.map((g, i) => (
          <li>
            <span class="mono">{String(i + 1).padStart(2, '0')}</span>
            <b>{g.mode}</b>
            {g.text && <p>{g.text}</p>}
            {g.todo && <p class:list={[{ todo: isTodo(g.todo) }]}>{g.todo}</p>}
          </li>
        ))}
      </ol>

      <div class="find">
        <div class="find-head">
          <h3 class="mono">Як знайти вхід</h3>
          <p class:list={['muted', { todo: isTodo(hall.find) }]}>{hall.find}</p>
        </div>
        <div class="find-photos m-rail">
          {hall.photos.map((p, i) => (
            <figure class="ph">
              <span class="step mono">{String(i + 1).padStart(2, '0')}</span>
              <figcaption class="cap"><b>{p.cap}</b><br />Фото з фотосесії: {p.brief}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Tape tilt={1.4} reverse />

  <section class="blk">
    <div class="wrap visit">
      <div>
        <RoundLabel n="Раунд 02" label="Перед візитом" />
        <h2 class="h2" data-punch>Питання до гонгу</h2>
      </div>
      <div class="faq-list">
        {visitFaq.map((f) => (
          <details>
            <summary>{f.q}<span aria-hidden="true">+</span></summary>
            <p class:list={[{ todo: isTodo(f.a) }]}>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Page>

<script>
  import { kyivNow } from '../../scripts/schedule-live';

  // Copy buttons (phone, address)
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    const label = b.textContent;
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = b.dataset.done!; }
      catch { b.textContent = b.dataset.copy!; }
      setTimeout(() => { b.textContent = label; }, 2200);
    });
  });

  // Training now / next training (club schedule, Kyiv time) and today's row in the week list
  type S = { name: string; days: number[]; from: number; to: number };
  const sessions: S[] = JSON.parse(document.querySelector<HTMLElement>('.week')!.dataset.sessions!);
  const hm = (m: number) => `${Math.floor(m / 60)}:${String(m % 60).padStart(2, '0')}`;
  const dayWords = ['', 'у понеділок', 'у вівторок', 'у середу', 'у четвер', 'у пʼятницю', 'у суботу', 'у неділю'];
  function status() {
    const { day, min } = kyivNow();
    const now = sessions.filter((s) => s.days.includes(day) && s.from <= min && min < s.to);
    let text = '';
    if (now.length) {
      const end = Math.min(...now.map((s) => s.to));
      text = `Зараз тренування: ${now.map((s) => s.name).join(', ')} · до ${hm(end)}`;
    } else {
      for (let k = 0; k < 8 && !text; k++) {
        const d = ((day - 1 + k) % 7) + 1;
        const next = sessions.filter((s) => s.days.includes(d) && (k > 0 || s.from > min)).sort((a, b) => a.from - b.from)[0];
        if (!next) continue;
        const when = k === 0 ? `сьогодні о ${hm(next.from)}` : k === 1 ? `завтра о ${hm(next.from)}` : `${dayWords[d]} о ${hm(next.from)}`;
        text = `${k === 0 ? 'Перерва' : day > 5 ? 'Сьогодні вихідний' : 'На сьогодні все'} · наступне тренування ${when}`;
      }
    }
    document.querySelectorAll<HTMLElement>('.open-state').forEach((el) => {
      el.classList.toggle('is-open', now.length > 0);
      el.querySelector('span')!.textContent = text;
    });
    document.querySelectorAll<HTMLElement>('.week li').forEach((li) => li.classList.toggle('today', +li.dataset.dow! === day));
  }
  status(); setInterval(status, 30000);

  // Travel mode switch for the route button
  const routeBtn = document.getElementById('routeBtn') as HTMLAnchorElement;
  document.querySelectorAll<HTMLButtonElement>('.modes button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.modes button').forEach((o) => o.setAttribute('aria-checked', String(o === b)));
    routeBtn.href = b.dataset.href!;
  }));

  // The Google map sets Google's cookies, so it loads only with the visitor's "maps" consent,
  // and only once it is on screen (Google's embed may skip drawing tiles if it starts hidden).
  const frame = document.querySelector<HTMLIFrameElement>('.mapx-map iframe')!;
  const gate = document.getElementById('mapGate')!;
  const startMap = () => {
    gate.hidden = true; frame.parentElement!.classList.remove('gated');
    const mio = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { frame.src = frame.dataset.src!; mio.disconnect(); }
    }, { rootMargin: '0px 0px -10% 0px' });
    mio.observe(frame.parentElement!);
  };
  const consent = () => (window as any).sbxConsent?.get();
  if (consent()?.maps) startMap();
  document.addEventListener('sbx:consent', (e) => { if ((e as CustomEvent).detail.maps && !frame.src) startMap(); });
  document.getElementById('mapAllow')!.addEventListener('click', () => (window as any).sbxConsent.set({ maps: true }));

  // The map does not hijack page scroll: it becomes interactive after a click
  const shield = document.getElementById('mapShield')!;
  const map = shield.parentElement!;
  shield.addEventListener('click', () => map.classList.add('live'));
  map.addEventListener('mouseleave', () => map.classList.remove('live'));
</script>

<style is:global>
  .call-card { border: 1px solid var(--line); background: var(--surface); padding: 20px 22px; display: flex; flex-direction: column; gap: 8px; }
  .call-num { font-family: var(--display); font-style: italic; font-weight: 900; font-size: clamp(30px, 4.4vw, 64px); line-height: .95; white-space: nowrap; transition: color var(--t-fast) var(--ease-out); }
  .call-num:hover { color: var(--red); }
  @media (max-width: 560px) { .call-num { font-size: min(9.4vw, 44px); } }
  .call-row { display: flex; flex-wrap: wrap; gap: 0 28px; }
  .call-row .link, .route .link { height: 44px; font-size: 13px; text-transform: none; letter-spacing: 0; }

  .open-state { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); }
  .open-state i { width: 9px; height: 9px; border-radius: 50%; background: var(--muted); flex: none; }
  .open-state.is-open { color: var(--fg); }
  .open-state.is-open i { background: #3ddc84; box-shadow: 0 0 0 0 rgba(61,220,132,.6); animation: openPulse 1.8s ease-out infinite; }
  @keyframes openPulse { to { box-shadow: 0 0 0 10px rgba(61,220,132,0); } }
  .open-state.big { font-size: 13px; margin: 0; }

  /* Map section */
  .mapx { position: relative; min-height: min(86vh, 820px); border-bottom: 1px solid var(--line); display: flex; align-items: center; overflow: hidden; scroll-margin-top: 0; }
  .mapx-map { position: absolute; inset: 0; background: #111; }
  .mapx-map.gated::before { content: none; }
  .map-gate { position: absolute; inset: 0; z-index: 3; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; text-align: center; padding: 24px;
    background: repeating-linear-gradient(135deg, #0e0e0d 0 14px, #121211 14px 28px); }
  .map-gate p { margin: 0; font-size: 12px; }
  .mapx-map::before { content: "Завантажуємо карту…"; position: absolute; left: 50%; top: 50%; transform: translate(-50%, 40px); font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
  .mapx-map iframe { position: absolute; inset: -60px 0 -60px 0; width: 100%; height: calc(100% + 120px); border: 0; filter: grayscale(1) invert(.92) contrast(.88) brightness(.9); }
  .mapx-map::after { content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, rgba(5,5,5,.88) 0%, rgba(5,5,5,.45) 34%, rgba(5,5,5,0) 58%), linear-gradient(180deg, var(--bg) 0, transparent 14%, transparent 86%, var(--bg) 100%); }
  .map-shield { position: absolute; inset: 0; z-index: 2; background: transparent; border: 0; cursor: pointer; display: flex; align-items: flex-end; justify-content: flex-end; padding: 24px max(var(--gxr), 4vw); }
  .map-shield span { background: rgba(5,5,5,.8); border: 1px solid var(--line); padding: 10px 14px; color: var(--muted); opacity: 0; transform: translateY(6px); transition: opacity var(--t-fast) var(--ease-out), transform var(--t-fast) var(--ease-out); }
  .map-shield:hover span, .map-shield:focus-visible span { opacity: 1; transform: none; }
  .mapx-map.live .map-shield { pointer-events: none; }
  .mapx-map.live .map-shield span { opacity: 0; }
  .radar { position: absolute; left: 50%; top: 50%; width: 0; height: 0; z-index: 1; pointer-events: none; }
  .radar i { position: absolute; left: -90px; top: -110px; width: 180px; height: 180px; border: 2px solid var(--red); border-radius: 50%; opacity: 0; animation: radar 3s ease-out infinite; }
  .radar i:nth-child(2) { animation-delay: 1s; } .radar i:nth-child(3) { animation-delay: 2s; }
  @keyframes radar { 0% { transform: scale(.15); opacity: .9; } 100% { transform: scale(1.4); opacity: 0; } }
  .mapx-wrap { position: relative; z-index: 3; pointer-events: none; padding-block: 56px; }
  .gym-card {
    pointer-events: auto; width: min(440px, 100%); background: rgba(10,10,9,.94); border: 1px solid var(--line);
    padding: 28px 28px 24px; display: flex; flex-direction: column; gap: 10px; position: relative;
    box-shadow: 0 30px 80px rgba(0,0,0,.6); backdrop-filter: blur(6px);
  }
  .gym-card::before { content: ""; position: absolute; left: -1px; top: -1px; bottom: -1px; width: 6px; background: var(--red); }
  .corner { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); }
  .corner i { width: 12px; height: 12px; background: var(--red); }
  .gym-card h2 { font-family: var(--display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(40px, 4vw, 58px); line-height: .9; margin-top: 6px; }
  .gym-name { margin: 0 0 4px; font-family: var(--serif); font-size: 19px; }
  .gym-rate { color: var(--muted); font-size: 12px; align-self: flex-start; }
  .gym-rate b { color: #f4b400; font-weight: 500; }
  .gym-rate:hover { color: var(--fg); }
  .week { list-style: none; margin: 8px 0 0; padding: 12px 0 0; border-top: 1px solid var(--line); display: grid; gap: 4px; font-size: 12px; color: var(--muted); }
  .week li { display: flex; justify-content: space-between; padding: 3px 0; }
  .week li.today { color: var(--fg); font-weight: 500; }
  .week li.off span:last-child { color: rgba(244,244,242,.3); }
  .week li.today span:first-child::after { content: " · сьогодні"; color: var(--red); }
  .week-link { color: var(--fg); align-self: flex-start; border-bottom: 1px solid var(--red); padding-bottom: 2px; font-size: 12px; }
  .route { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; padding-top: 16px; border-top: 1px solid var(--line); }
  .modes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border: 1px solid var(--line); }
  .modes button { height: 40px; background: none; border: 0; border-right: 1px solid var(--line); color: var(--muted); cursor: pointer; font-size: 12px; }
  .modes button:last-child { border-right: 0; }
  .modes button[aria-checked="true"] { background: var(--fg); color: var(--bg); }
  .route .btn { justify-content: space-between; }
  .route .link { align-self: flex-start; }

  /* How to get here */
  .get-here { list-style: none; margin: clamp(32px, 4vw, 56px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .get-here li { padding: 28px 24px 32px 0; display: flex; flex-direction: column; gap: 10px; border-right: 1px solid var(--line); }
  .get-here li + li { padding-left: 24px; }
  .get-here li:last-child { border-right: 0; }
  .get-here .mono { color: var(--red); }
  .get-here b { font-family: var(--display); font-style: italic; font-weight: 800; text-transform: uppercase; font-size: clamp(28px, 2.6vw, 40px); line-height: .95; }
  .get-here p { margin: 0; color: var(--muted); }
  .find { margin-top: clamp(48px, 6vw, 88px); }
  .find-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 32px; align-items: baseline; margin-bottom: 20px; }
  .find-head h3 { color: var(--fg); }
  .find-head p { margin: 0; }
  .find-photos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .find-photos .ph { aspect-ratio: 4 / 3; margin: 0; flex-direction: column; justify-content: space-between; align-items: flex-start; }
  .find-photos .step { color: var(--red); position: relative; z-index: 1; padding: 4px 0 0 18px; }
  .find-photos .cap b { color: var(--fg); font-weight: 500; }

  /* Visit FAQ */
  .visit { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 32px clamp(32px, 6vw, 96px); align-items: start; }
  .faq-list { border-top: 1px solid var(--line); }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 16px; padding: 22px 0; font-size: 19px; font-weight: 500; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary span { color: var(--red); font-family: var(--mono); transition: transform var(--t) var(--ease-out); }
  .faq-list details[open] summary span { transform: rotate(45deg); }
  .faq-list details p { margin: 0 0 22px; color: var(--muted); max-width: 56ch; }

  @media (max-width: 980px) {
    .mapx { display: block; min-height: 0; }
    .mapx-map { position: relative; height: 62vh; min-height: 360px; }
    .mapx-map::after { background: linear-gradient(180deg, var(--bg) 0, transparent 14%, transparent 80%, var(--bg) 100%); }
    .map-shield span { opacity: 1; transform: none; }
    .mapx-wrap { padding-block: 0 40px; margin-top: -64px; }
    .gym-card { width: 100%; }
    .get-here li, .get-here li + li { padding: 22px; }
    .find-photos .ph { min-height: 220px; }
    .visit { grid-template-columns: minmax(0, 1fr); }
  }
</style>
