---
import Page from '../../layouts/Page.astro';
import Tape from '../../components/Tape.astro';
import RoundLabel from '../../components/RoundLabel.astro';
import { site, halls, socials } from '../../data/site';
import { isTodo, link } from '../../lib/util';

const enc = encodeURIComponent;
const channels = [
  { label: 'Подзвонити', value: site.phone.display, href: `tel:${site.phone.tel}` },
  { label: 'Telegram', value: site.messengers.telegram === '#' ? '[посилання]' : 'Написати', href: site.messengers.telegram },
  { label: 'Viber', value: site.messengers.viber === '#' ? '[посилання]' : 'Написати', href: site.messengers.viber },
  { label: 'Пошта', value: site.email, href: `mailto:${site.email}` },
  ...socials.filter((s) => !s.note).map((s) => ({ label: s.label, value: 'Відкрити ↗', href: s.href })),
];
---
<Page
  title="Контакти — Світ Боксу, Бровари"
  description="Зал боксерського клубу «Світ Боксу» у Броварах: вул. Героїв України, 30, спорткомплекс «Манеж». Телефон +38 (073) 721 71 71."
  current="kontakty/"
  kicker="Контакти"
  heading="Контакти"
  lead="Зал у спорткомплексі «Манеж» у Броварах. Подзвоніть або напишіть — підберемо групу під ваш графік."
>
  <div slot="head" class="call-card">
    <span class="mono muted">Дзвоніть щодня з 7:00 до 22:00</span>
    <a class="call-num" href={`tel:${site.phone.tel}`}>{site.phone.display}</a>
    <div class="call-row">
      <button type="button" class="link" id="copyPhone" data-phone={site.phone.display}>Копіювати номер</button>
      <a class="link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>

  <section class="blk">
    <div class="wrap">
      <RoundLabel n="Раунд 01" label="Зал" />
      <div class="sched-head">
        <h2 class="h2" data-punch>Де тренуємось</h2>
        <p class="muted">Усі групи — в одному залі. Приходьте за 10–15 хвилин до початку, щоб переодягнутись.</p>
      </div>
      <div class="halls">
        {halls.map((h, i) => (
          <article class:list={['hall', { red: i === 0 }]} id={h.id}>
            <div class="hall-info">
              <span class="corner mono"><i aria-hidden="true"></i>{h.corner}</span>
              <h3>{h.address}</h3>
              <p class="hall-name">{h.name}</p>
              <ul class="mono">
                <li>{h.hours}</li>
                {h.notes.map((n) => <li>{n}</li>)}
                <li class:list={[{ todo: isTodo(h.find) }]}>{h.find}</li>
              </ul>
              <div class="hall-btns">
                <a class="btn" href={`https://www.google.com/maps/dir/?api=1&destination=${enc(h.query)}`} target="_blank" rel="noopener"><span>Маршрут</span><span class="arr">↗</span></a>
                <a class="link" href="#signup">Записатись на тренування</a>
              </div>
            </div>
            <div class="hall-map">
              <iframe title={`Карта: ${h.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                src={`https://maps.google.com/maps?q=${enc(h.query)}&z=16&hl=uk&output=embed`}></iframe>
              <span class="pin" aria-hidden="true"></span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Tape tilt={1.4} reverse />

  <section class="blk">
    <div class="wrap">
      <RoundLabel n="Раунд 02" label="Звʼязок" />
      <h2 class="h2" data-punch>Напишіть нам</h2>
      <ul class="channels">
        {channels.map((c) => (
          <li>
            <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined}>
              <b>{c.label}</b>
              <span class:list={['mono', { todo: isTodo(c.value) }]}>{c.value}</span>
              <span class="go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="muted other-note">Хочете спершу подивитись на групу? <a class="link-inline" href={link('rozklad/')}>Розклад тренувань →</a></p>
    </div>
  </section>
</Page>

<script>
  const btn = document.getElementById('copyPhone')!;
  btn.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(btn.dataset.phone!); btn.textContent = 'Скопійовано ✓'; }
    catch { btn.textContent = btn.dataset.phone!; }
    setTimeout(() => { btn.textContent = 'Копіювати номер'; }, 2000);
  });
</script>

<style is:global>
  .call-card { border: 1px solid var(--line); background: var(--surface); padding: 20px 22px; display: flex; flex-direction: column; gap: 6px; }
  .call-num { font-family: var(--display); font-style: italic; font-weight: 900; font-size: clamp(30px, 4.4vw, 64px); line-height: .95; white-space: nowrap; transition: color .25s; }
  @media (max-width: 560px) { .call-num { font-size: min(9.4vw, 44px); } }
  .call-num:hover { color: var(--red); }
  .call-row { display: flex; flex-wrap: wrap; gap: 0 28px; }
  .call-row .link { height: 44px; font-size: 13px; text-transform: none; letter-spacing: 0; }

  .halls { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; }
  .hall { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); border: 1px solid var(--line); scroll-margin-top: 24px; }
  .hall-info { padding: clamp(24px, 3vw, 44px); display: flex; flex-direction: column; gap: 12px; position: relative; }
  .hall-info::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 6px; background: #e8e8e4; }
  .hall.red .hall-info::before { background: var(--red); }
  .corner { display: inline-flex; align-items: center; gap: 10px; color: var(--muted); }
  .corner i { width: 14px; height: 14px; background: #e8e8e4; }
  .hall.red .corner i { background: var(--red); }
  .hall h3 { font-family: var(--display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(38px, 4.2vw, 64px); line-height: .9; margin-top: 8px; }
  .hall-name { margin: 0; font-family: var(--serif); font-size: 19px; }
  .hall ul { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; color: var(--muted); }
  .hall ul li::before { content: "— "; color: var(--red); }
  .hall-btns { margin-top: auto; padding-top: 20px; display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; }
  .hall-map { position: relative; min-height: 380px; border-left: 1px solid var(--line); background: var(--surface); overflow: hidden; }
  .hall-map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; filter: grayscale(1) invert(.92) contrast(.9) brightness(.95); transition: filter .5s; }
  .hall-map:hover iframe { filter: grayscale(.2) invert(0) contrast(1); }
  .hall-map .pin { position: absolute; left: 50%; top: 50%; width: 22px; height: 22px; margin: -30px 0 0 -11px; background: var(--red); transform: rotate(45deg); border-radius: 50% 50% 0 50%; pointer-events: none; box-shadow: 0 0 0 6px rgba(255,41,54,.25); animation: pinPulse 2s ease-in-out infinite; transition: opacity .3s; }
  .hall-map:hover .pin { opacity: 0; }
  @keyframes pinPulse { 50% { box-shadow: 0 0 0 14px rgba(255,41,54,0); } }

  .channels { list-style: none; margin: clamp(32px, 4vw, 56px) 0 0; padding: 0; border-top: 1px solid var(--line); }
  .channels a { display: grid; grid-template-columns: minmax(0, 1fr) auto 56px; gap: 24px; align-items: center; padding-block: 20px; border-bottom: 1px solid var(--line); }
  .channels b { font-family: var(--display); font-style: italic; font-weight: 800; text-transform: uppercase; font-size: clamp(32px, 4vw, 60px); line-height: .95; transition: transform .35s var(--ease-io), color .25s; }
  .channels .go { width: 48px; height: 48px; border: 1px solid var(--line); display: grid; place-items: center; transition: background .25s, color .25s, transform .35s; }
  @media (hover: hover) {
    .channels a:hover b { transform: translateX(14px); color: var(--red); }
    .channels a:hover .go { background: var(--fg); color: var(--bg); transform: rotate(-45deg); }
  }
  .other-note { margin: 28px 0 0; max-width: 60ch; }
  .link-inline { color: var(--fg); border-bottom: 1px solid var(--red); white-space: nowrap; }
  @media (max-width: 980px) {
    .hall { grid-template-columns: minmax(0, 1fr); }
    .hall-map { border-left: 0; border-top: 1px solid var(--line); min-height: 280px; }
    .hall-btns .btn { width: 100%; justify-content: center; }
    .channels a { grid-template-columns: minmax(0, 1fr) 44px; gap: 4px 16px; }
    .channels a .mono { grid-row: 2; grid-column: 1; }
    .channels .go { grid-row: 1 / span 2; grid-column: 2; width: 44px; height: 44px; }
  }
</style>
