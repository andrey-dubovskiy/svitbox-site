---
// Program landings that have no old-site URL to keep live under /programy/<slug>/.
import ProgramLanding from '../../components/ProgramLanding.astro';
import { programs, type Program } from '../../data/programs';
export function getStaticPaths() {
  return programs.filter((p) => !p.path).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Program };
---
<ProgramLanding p={p} />
