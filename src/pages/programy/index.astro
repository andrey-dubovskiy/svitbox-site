---
import Page from '../../layouts/Page.astro';
import { programs } from '../../data/programs';
import { asset, link, isTodo } from '../../lib/util';
---
<Page
  title="Програми тренувань — Світ Боксу, Бровари"
  description="Бокс для дітей і юніорів, дівчат, чоловіків, індивідуальні та функціональні тренування в клубі «Світ Боксу» у Броварах."
  current="programy/"
  kicker="Програми"
  heading="Програми"
  lead="Пʼять форматів — від першого тренування дитини до підготовки до турнірів. Оберіть свій, тренер підбере групу за віком і рівнем."
>
  <section class="blk">
    <div class="wrap">
      <ol class="pr-list">
        {programs.map((p, i) => (
          <li>
            <a href={link(`programy/${p.slug}/`)}>
              <span class="pr-num mono">{String(i + 1).padStart(2, '0')}</span>
              <img src={asset(p.img)} alt="" loading={i < 2 ? 'eager' : 'lazy'} style={`object-position:${p.pos ?? '50% 50%'}`} />
              <span class="pr-body">
                <span class="mono pr-kick">{p.kicker}</span>
                <b>{p.name}</b>
                <span class="pr-short">{p.short}</span>
              </span>
              <span class="pr-meta mono">
                <span>{p.when}</span>
                <span class:list={[{ todo: isTodo(p.from) }]}>{p.from}</span>
              </span>
              <span class="pr-go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Page>

<style is:global>
  .pr-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .pr-list a { display: grid; grid-template-columns: 40px 200px minmax(0, 1fr) minmax(180px, auto) 56px; gap: 28px; align-items: center; padding-block: 22px; border-bottom: 1px solid var(--line); transition: background .25s; }
  .pr-num { color: var(--red); align-self: start; padding-top: 6px; }
  .pr-list img { width: 200px; aspect-ratio: 4 / 3; object-fit: cover; filter: grayscale(1) contrast(1.05); transition: filter .4s; border: 1px solid var(--line); }
  .pr-body { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .pr-kick { color: var(--muted); font-size: 11px; }
  .pr-body b { font-family: var(--display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(36px, 4.4vw, 72px); line-height: .88; transition: color .2s, transform .35s var(--ease-io); }
  .pr-short { color: var(--muted); max-width: 52ch; }
  .pr-meta { display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--muted); text-align: right; }
  .pr-go { width: 56px; height: 56px; border: 1px solid var(--line); display: grid; place-items: center; transition: background .25s, color .25s, transform .35s; }
  @media (hover: hover) {
    .pr-list a:hover img { filter: grayscale(.1); }
    .pr-list a:hover b { color: var(--red); transform: translateX(12px); }
    .pr-list a:hover .pr-go { background: var(--fg); color: var(--bg); transform: rotate(-45deg); }
  }
  @media (max-width: 980px) {
    .pr-list a { grid-template-columns: 96px minmax(0, 1fr) 44px; gap: 10px 16px; align-items: start; }
    .pr-num { display: none; }
    .pr-list img { width: 96px; grid-row: 1 / span 2; }
    .pr-body b { font-size: clamp(30px, 8.6vw, 52px); }
    .pr-meta { grid-column: 2 / -1; grid-row: 2; text-align: left; }
    .pr-go { width: 44px; height: 44px; grid-column: 3; grid-row: 1; }
  }
</style>
