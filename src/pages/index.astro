---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Programs from '../components/Programs.astro';
import Club from '../components/Club.astro';
import HeavyBag from '../components/HeavyBag.astro';
import Coaches from '../components/Coaches.astro';
import Champions from '../components/Champions.astro';
import VideoBrief from '../components/VideoBrief.astro';
import Life from '../components/Life.astro';
import Reviews from '../components/Reviews.astro';
import FirstTraining from '../components/FirstTraining.astro';
import Signup from '../components/Signup.astro';
import PagesNav from '../components/PagesNav.astro';
import Scoreboard from '../components/Scoreboard.astro';
import MobileBar from '../components/MobileBar.astro';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
---
<Base>
  <Hero />
  <MobileMenu />
  <Marquee />
  <main id="main">
    <Programs />
    <Club />
    <HeavyBag />
    <Coaches />
    <Champions />
    <VideoBrief />
    <Life />
    <Reviews />
    <FirstTraining />
    <Signup />
