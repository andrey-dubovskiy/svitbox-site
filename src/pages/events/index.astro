---
// Club events at the old site's URL /events. Kinds of events with photos; dated announcements on top when there are any.
import Page from '../../layouts/Page.astro';
import Lightbox from '../../components/Lightbox.astro';
import RingCard from '../../components/RingCard.astro';
import { eventKinds, upcoming } from '../../data/events';
import { socials, site } from '../../data/site';
import { asset, link } from '../../lib/util';
const thumb = (src: string) => src.replace('img/club/', 'img/club/thumb/').replace('.jpg', '.webp');
const ig = socials.find((s) => /instagram/i.test(s.href));
---
<Page
  title="Події клубу «Світ Боксу»: турніри, профі-бої, походи — Бровари"
  description="Боксерський клуб «Світ Боксу» живе активним життям: турніри, вечори професійного боксу, гості-чемпіони, походи в Карпати, сплави й літні збори."
  current="events/"
  kicker="Життя клубу"
  heading="Події клубу"
  lead="Наш клуб живе активним життям: ми постійно беремо участь у змаганнях і турнірах, а до нашого залу люблять приходити знамениті, титуловані боксери."
>
  <section class="blk ev-next" aria-labelledby="evNext">
    <div class="wrap ev-next-in">
      <div class="ev-next-card"><RingCard top="Наступний раунд" big="01" small="Скоро" /></div>
      <div class="ev-next-text">
        <h2 class="read-h2" id="evNext">Найближчі події</h2>
        {upcoming.length ? (
          <ol class="ev-up">
            {upcoming.map((u) => <li><span class="mono n">{u.date}</span><b>{u.title}</b><span class="muted">{u.text}</span></li>)}
          </ol>
        ) : (
          <p class="ev-read">Анонси турнірів, виїздів і зустрічей з чемпіонами першими з’являються в соцмережах клубу. Підписуйтесь, щоб не пропустити наступний раунд.</p>
        )}
        <div class="ev-links">
          {ig && <a class="btn" href={ig.href} target="_blank" rel="noopener"><span>Instagram клубу</span><span class="arr">↗</span></a>}
          <a class="link" href={site.messengers.telegram}>Telegram-канал <span class="todo">&nbsp;[посилання]</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="blk ev-list" aria-label="Що відбувається в клубі">
    <div class="wrap">
      {eventKinds.map((e, i) => (
        <article class:list={['ev', { flip: i % 2 === 1 }]}>
          <div class="ev-text">
            <span class="mono ev-tag"><span class="n">{String(i + 1).padStart(2, '0')}</span> · {e.tag}</span>
            <h2 class="ev-h" data-punch>{e.title}</h2>
            <p class="ev-read">{e.text}</p>
            <a class="link-inline mono" href={link(`galereya/#${e.id}`)}>Більше фото в галереї →</a>
          </div>
          <div class="ev-photos">
            {e.photos.map((ph, k) => (
              <figure class:list={['ph', 'photo', `ev-ph-${k}`]} data-full={asset(ph.src)} data-cap={ph.alt} tabindex="0">
                <img src={asset(thumb(ph.src))} alt={ph.alt} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
  <Lightbox />
</Page>

<style is:global>
  .ev-next { padding-block: clamp(48px, 6vw, 88px); }
  .ev-next-in { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .ev-next-card .rcard { --w: clamp(170px, 18vw, 250px); }
  .ev-next-text { display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .ev-read { font-family: var(--serif); font-size: clamp(18px, 1.5vw, 21px); line-height: 1.5; margin: 0; max-width: 36em; }
  .ev-links { display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; }
  .ev-up { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .ev-up li { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 4px 24px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .ev-up .n { color: var(--red); grid-row: span 2; }

  .ev-list { padding-top: 0; }
  .ev { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 5vw, 80px); align-items: center; padding-block: clamp(40px, 6vw, 88px); border-top: 1px solid var(--line); }
  .ev.flip { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  .ev.flip .ev-photos { order: -1; }
  .ev-text { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .ev-tag { color: var(--muted); }
  .ev-tag .n { color: var(--red); }
  .ev-h { font-family: var(--display); font-style: italic; font-weight: 900; font-size: clamp(40px, 4.4vw, 76px); line-height: .88; text-transform: uppercase; overflow-wrap: anywhere; }
  .ev-photos { display: grid; grid-template-columns: 1.6fr 1fr; grid-template-rows: 1fr 1fr; gap: 10px; aspect-ratio: 16 / 11; min-width: 0; }
  .ev-photos .ph { margin: 0; padding: 0; cursor: zoom-in; }
  .ev-ph-0 { grid-row: span 2; }
  @media (max-width: 980px) {
    .ev-next-in { grid-template-columns: minmax(0, 1fr); }
    .ev-next-card { display: none; }
    .ev, .ev.flip { grid-template-columns: minmax(0, 1fr); }
    .ev.flip .ev-photos { order: 0; }
    .ev-photos { aspect-ratio: 4 / 3; gap: 6px; }
    .ev-links .btn { width: 100%; justify-content: space-between; }
  }
</style>
