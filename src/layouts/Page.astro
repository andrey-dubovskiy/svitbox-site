---
// Inner page: shared header, page title, content, sign-up form and footer.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Signup from '../components/Signup.astro';
import PagesNav from '../components/PagesNav.astro';
import MobileBar from '../components/MobileBar.astro';
import Footer from '../components/Footer.astro';
import RingHead from '../components/RingHead.astro';
import Tape from '../components/Tape.astro';
import { asset } from '../lib/util';

interface Props { title: string; description: string; current: string; kicker: string; heading: string; lead: string; signup?: boolean; alwaysNoindex?: boolean; }
const { title, description, current, kicker, heading, lead, signup = true, alwaysNoindex = false } = Astro.props;
---
<Base title={title} description={description} alwaysNoindex={alwaysNoindex}>
  <SiteHeader current={current} />
  <MobileMenu />
  <div class="page-head">
    <div class="wrap">
      <nav class="crumbs mono" aria-label="Ви тут"><a href={asset('')}>Головна</a><span aria-hidden="true">/</span><span>{kicker}</span></nav>
      <h1 class="page-h" data-punch style={`--chars:${[...heading].length}`}>{heading}</h1>
      <div class="page-lead">
        <p id="pageLead">{lead}</p>
        <slot name="head" />
      </div>
    </div>
    <RingHead />
  </div>
  <main>
    <slot />
    <Tape tilt={-1.2} />
    {signup && <Signup n="Останній раунд" />}
  </main>
  <PagesNav current={current} />
  <MobileBar />
  <Footer />
</Base>

<style is:global>
  .page-head { border-bottom: 1px solid var(--line); padding-block: clamp(40px, 6vw, 88px) clamp(40px, 5vw, 72px); }
  .crumbs { display: flex; gap: 12px; color: var(--muted); margin-bottom: clamp(24px, 4vw, 48px); }
  .crumbs a:hover { color: var(--fg); }
  .crumbs span:last-child { color: var(--red); }
  .page-h {
    font-family: var(--display); font-style: italic; font-weight: 900; text-transform: uppercase;
    font-size: clamp(76px, 15vw, 240px); line-height: .82; letter-spacing: -.01em;
  }
  .page-lead { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 48px; align-items: end; margin-top: clamp(28px, 4vw, 48px); }
  .page-lead > p { margin: 0; font-family: var(--serif); font-size: clamp(19px, 1.7vw, 24px); line-height: 1.4; max-width: 34ch; }
  @media (max-width: 980px) {
    .page-lead { grid-template-columns: minmax(0, 1fr); }
  }
  /* Phones: long titles shrink so they never run under the hanging gloves */
  @media (max-width: 760px) {
    .page-h { font-size: min(19vw, calc((100vw - 2 * max(var(--gx), 4vw) - 96px) / (var(--chars) * .54))); }
  }
</style>
