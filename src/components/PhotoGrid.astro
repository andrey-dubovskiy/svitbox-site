---
// Bento photo mosaic. Slots without a photo show a brief of what to shoot.
// Sizes: l = big square (2x2), t = tall (1x2), w = wide (2x1), n = normal.
import type { Shot } from '../data/programPhotos';
import { asset } from '../lib/util';
interface Props { shots: Shot[] }
const { shots } = Astro.props;
---
<div class="pg-gal-grid">
  {shots.map((g) => (
    <figure class:list={['ph', `g-${g.size ?? 'n'}`, { photo: g.src }]} data-full={g.src && asset(g.src)} tabindex={g.src ? 0 : undefined}>
      {g.src && <img src={asset(g.src)} alt={g.alt ?? `${g.cap}: ${g.brief}`} loading="lazy" />}
      <figcaption class="cap"><b>{g.cap}</b>{!g.src && <><br />Фото: {g.brief}</>}</figcaption>
    </figure>
  ))}
</div>

<style is:global>
  .pg-gal-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: clamp(150px, 15vw, 230px); grid-auto-flow: dense; gap: 12px; }
  .pg-gal-grid .ph { margin: 0; }
  .pg-gal-grid .g-l { grid-column: span 2; grid-row: span 2; }
  .pg-gal-grid .g-t { grid-row: span 2; }
  .pg-gal-grid .g-w { grid-column: span 2; }
  .pg-gal-grid .ph .cap b { color: var(--fg); font-weight: 500; }
  .pg-gal-grid .ph.photo { cursor: zoom-in; }
  .pg-gal-grid .ph.photo .cap { position: relative; z-index: 1; color: var(--fg); background: rgba(5,5,5,.6); padding: 4px 8px; }
  .pg-gal-grid .ph.photo:hover img, .pg-gal-grid .ph.photo:focus-visible img { filter: grayscale(0) contrast(1.05); transform: scale(1.04); }
  @media (max-width: 980px) {
    .pg-gal-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: 42vw; gap: 8px; }
  }
</style>
