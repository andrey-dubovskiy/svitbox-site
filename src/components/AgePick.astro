---
// "How old?" picker: highlights the schedule rows that fit the age (rows carry data-amin/amax).
---
<div class="age-pick" id="agePick">
  <div class="ap-l">
    <span class="mono muted">Підібрати групу</span>
    <p>Скільки років вам або дитині?</p>
  </div>
  <div class="ap-ctrl">
    <button type="button" class="ap-btn" data-step="-1" aria-label="Менше">−</button>
    <label class="sr-only" for="apAge">Вік</label>
    <input id="apAge" type="number" inputmode="numeric" min="3" max="80" placeholder="—" />
    <button type="button" class="ap-btn" data-step="1" aria-label="Більше">+</button>
    <button type="button" class="ap-reset mono" id="apReset" hidden>Скинути</button>
  </div>
  <p class="ap-out" id="apOut" aria-live="polite">Підсвітимо групи, які підходять за віком.</p>
</div>

<style is:global>
  .age-pick { display: grid; grid-template-columns: auto auto minmax(0, 1fr); gap: 16px 40px; align-items: center; border: 1px solid var(--line); background: var(--surface); padding: 18px 22px; margin-bottom: clamp(28px, 4vw, 48px); }
  .ap-l p { margin: 4px 0 0; font-size: 18px; font-weight: 500; }
  .ap-ctrl { display: flex; align-items: center; gap: 8px; }
  .ap-btn { width: 52px; height: 52px; border: 1px solid var(--line); background: none; color: var(--fg); font-size: 24px; cursor: pointer; transition: background var(--t-fast) var(--ease-out), color var(--t-fast) var(--ease-out); }
  .ap-btn:hover { background: var(--fg); color: var(--bg); }
  #apAge {
    width: 96px; height: 52px; text-align: center; background: var(--bg); color: var(--fg); border: 1px solid var(--line);
    font-family: var(--display); font-style: italic; font-weight: 900; font-size: 36px; -moz-appearance: textfield;
  }
  #apAge::-webkit-outer-spin-button, #apAge::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  #apAge:focus { outline: none; border-color: var(--red); }
  .ap-reset { background: none; border: 0; color: var(--muted); cursor: pointer; text-decoration: underline; text-underline-offset: 4px; margin-left: 6px; }
  .ap-out { margin: 0; color: var(--muted); }
  .ap-out b { color: var(--fg); font-weight: 600; }
  .ap-out a { color: var(--fg); border-bottom: 1px solid var(--red); }
  @media (max-width: 980px) {
    .age-pick { grid-template-columns: minmax(0, 1fr); gap: 12px; }
  }
</style>

<script>
  const input = document.getElementById('apAge') as HTMLInputElement;
  const out = document.getElementById('apOut')!, reset = document.getElementById('apReset')!;
  const rows = () => [...document.querySelectorAll<HTMLElement>('.tt tbody tr, .tt-day li')];
  const idle = out.innerHTML;

  function apply() {
    const age = parseInt(input.value, 10);
    reset.hidden = !input.value;
    rows().forEach((r) => r.classList.remove('match', 'dim'));
    if (!age) { out.innerHTML = idle; return; }
    if (age < 5) { out.innerHTML = 'Беремо з <b>5 років</b>. Подзвоніть — порадимо, як підготуватись.'; return; }
    const names = new Set<string>();
    let signup = '';
    rows().forEach((r) => {
      if (!r.dataset.amin) return; // functional groups: no age rule
      const ok = age >= +r.dataset.amin && age <= +r.dataset.amax!;
      r.classList.add(ok ? 'match' : 'dim');
      if (ok) {
        names.add(r.querySelector('b')!.textContent!);
        const join = r.querySelector<HTMLElement>('[data-signup]');
        if (join && !signup && +r.dataset.amax! < 99) signup = join.dataset.signup!;
      }
    });
    if (!signup) signup = age >= 18 ? 'adults' : '';
    out.innerHTML = `Підходять: <b>${[...names].join(', ')}</b>. ` +
      (signup ? `<a href="#signup" data-signup="${signup}">Записатись →</a>` : '');
  }
  input.addEventListener('input', apply);
  document.querySelectorAll<HTMLButtonElement>('.ap-btn').forEach((b) => b.addEventListener('click', () => {
    const v = (parseInt(input.value, 10) || (+b.dataset.step! > 0 ? 4 : 19)) + +b.dataset.step!;
    input.value = String(Math.max(3, Math.min(80, v))); apply();
  }));
  reset.addEventListener('click', () => { input.value = ''; apply(); input.focus(); });
</script>
