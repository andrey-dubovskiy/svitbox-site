---
// Fixed round scoreboard: shows the current section as a boxing round, with an optional bell.
---
<aside class="board" id="board" aria-label="Табло раунду">
  <div class="board-top mono">
    <span class="board-r">Раунд <b id="bNum">01</b><span class="muted"> / 08</span></span>
    <button type="button" class="snd" id="snd" aria-pressed="false" aria-label="Звук гонга">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M4 9v6h4l5 4V5L8 9H4z"></path>
        <path class="snd-wave" d="M16.5 8.5a5 5 0 0 1 0 7"></path>
        <path class="snd-x" d="M17 9l5 6M22 9l-5 6"></path>
      </svg>
    </button>
  </div>
  <div class="board-name" id="bName">Програми</div>
  <div class="board-bar"><i id="bBar"></i></div>
</aside>

<style is:global>
  .board {
    position: fixed; left: max(16px, env(safe-area-inset-left, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 25; width: 290px; background: rgba(5,5,5,.88); border: 1px solid var(--line); padding: 12px 14px;
    display: flex; flex-direction: column; gap: 8px;
    transform: translateY(calc(100% + 40px)); transition: transform .45s var(--ease-out);
  }
  .board.on { transform: none; }
  .board.off, .board.on.off { transform: translateY(calc(100% + 40px)); }
  .board-top { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .board-r b { color: var(--red); font-weight: 500; display: inline-block; }
  .board-name { font-family: var(--display); font-style: italic; font-weight: 800; font-size: 24px; line-height: 1; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .board-bar { height: 3px; background: var(--surface); position: relative; }
  .board-bar i { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--fg); }
  .snd { width: 32px; height: 32px; display: grid; place-items: center; background: none; border: 1px solid var(--line); color: var(--muted); cursor: pointer; }
  .snd[aria-pressed="true"] { color: var(--fg); border-color: var(--fg); }
  .snd[aria-pressed="true"] .snd-x, .snd[aria-pressed="false"] .snd-wave { display: none; }
  .board.ding { animation: ding .6s ease-out; }
  @keyframes ding {
    0% { border-color: var(--red); box-shadow: 0 0 0 0 rgba(255,41,54,.6); }
    100% { border-color: var(--line); box-shadow: 0 0 0 18px rgba(255,41,54,0); }
  }
  @media (max-width: 980px) { .board { display: none; } }
</style>

<script>
  import { reduce } from '../scripts/motion';
  import { gong, toggleSound } from '../scripts/sound';

  const board = document.getElementById('board')!;
  const bNum = document.getElementById('bNum')!, bName = document.getElementById('bName')!, bBar = document.getElementById('bBar')!;
  const snd = document.getElementById('snd')!;
  snd.addEventListener('click', () => snd.setAttribute('aria-pressed', String(toggleSound())));

  // Every section with a "Раунд NN" label is a round
  const rounds = [...document.querySelectorAll<HTMLElement>('section.blk')].map((s) => {
    const n = s.querySelector('.round .n');
    const m = n?.textContent?.match(/Раунд\s+(\d+)/);
    return m ? { el: s, num: m[1], name: n!.nextElementSibling?.textContent ?? '' } : null;
  }).filter(Boolean) as { el: HTMLElement; num: string; name: string }[];

  let cur = -1;
  function onScroll() {
    const line = innerHeight * .45;
    let idx = -1;
    rounds.forEach((r, i) => { if (r.el.getBoundingClientRect().top <= line) idx = i; });
    board.classList.toggle('on', idx >= 0);
    if (idx < 0) return;
    const r = rounds[idx], rect = r.el.getBoundingClientRect();
    const next = rounds[idx + 1] ? rounds[idx + 1].el.getBoundingClientRect().top : rect.bottom;
    bBar.style.width = Math.min(100, Math.max(0, (line - rect.top) / Math.max(1, next - rect.top) * 100)) + '%';
    if (idx !== cur) {
      const first = cur === -1; cur = idx;
      bNum.textContent = r.num; bName.textContent = r.name;
      if (!first) {
        if (!reduce) {
          board.classList.remove('ding'); void board.offsetWidth; board.classList.add('ding');
          bNum.animate([{ transform: 'translateY(-60%)', opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 350, easing: 'cubic-bezier(.2,.8,.2,1)' });
        }
        gong();
      }
    }
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
