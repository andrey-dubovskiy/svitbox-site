---
// Red accent band that breaks the black page: either a question with an honest answer
// (same look as the fear block on program pages) or a big quote from a real review.
import { link as toLink } from '../lib/util';
interface Props {
  q: string;                 // big text on the left (question or quote)
  label?: string;            // black tag above the answer
  text?: string[];           // answer paragraphs
  cite?: string;             // quote author / source line
  href?: string; more?: string;
  quote?: boolean;           // true = review quote layout
}
const { q, label, text = [], cite, href, more, quote = false } = Astro.props;
---
<section class:list={['red-blk', { 'red-quote': quote }]}>
  <div class="wrap red-in">
    {quote
      ? <blockquote class="red-q"><span aria-hidden="true">«</span>{q}<span aria-hidden="true">»</span></blockquote>
      : <h2 class="red-q"><span aria-hidden="true">«</span>{q}<span aria-hidden="true">»</span></h2>}
    <div class="red-a">
      {label && <span class="red-tag mono">{label}</span>}
      {text.map((t) => <p>{t}</p>)}
      {cite && <p class="red-cite mono">{cite}</p>}
      {href && <a class="red-more mono" href={toLink(href)}>{more} →</a>}
    </div>
  </div>
</section>

<style is:global>
  .red-blk { background: #d6202d; color: var(--fg); padding-block: clamp(56px, 8vw, 120px); }
  .red-in { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 32px clamp(32px, 6vw, 96px); align-items: center; }
  .red-q { margin: 0; font-family: var(--display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: clamp(48px, 6.4vw, 108px); line-height: .88; text-wrap: balance; }
  .red-q span { color: #050505; }
  .red-quote .red-in { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  .red-quote .red-q { text-transform: none; font-size: clamp(44px, 6vw, 104px); line-height: .95; max-width: 15em; }
  .red-quote .red-a { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 32px; }
  .red-quote .red-a p, .red-quote .red-more { margin: 0; }
  .red-tag { display: inline-block; background: #050505; color: var(--fg); padding: 6px 10px; font-size: 11px; margin-bottom: 16px; }
  .red-a p { margin: 0 0 14px; font-family: var(--serif); font-size: clamp(18px, 1.5vw, 22px); line-height: 1.5; }
  .red-cite { font-size: 13px !important; font-family: var(--mono) !important; letter-spacing: .03em; text-transform: uppercase; }
  .red-more { display: inline-block; margin-top: 6px; color: var(--fg); border-bottom: 1px solid #050505; padding-bottom: 3px; font-size: 13px; text-transform: uppercase; }
  .red-more:hover { color: #050505; }
  @media (max-width: 980px) { .red-in { grid-template-columns: minmax(0, 1fr); } }
</style>
