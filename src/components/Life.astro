---
// Round 05: club life outside the gym.
import RoundLabel from './RoundLabel.astro';
import RailHint from './RailHint.astro';
import { life, lifeAbout } from '../data/content';
import { asset, link } from '../lib/util';
---
<section class="blk" id="life">
  <div class="wrap">
    <RoundLabel n="Раунд 05" label="Більше, ніж зал" />
    <div class="club-read life-read">
      <h2 class="read-h2" data-punch>{lifeAbout.h2}</h2>
      <div>{lifeAbout.text.map((t) => <p class="read-p">{t}</p>)}</div>
    </div>
    <div class="life m-rail">
      {life.map((l) => (
        <article class="reveal-parent">
          <div class="ph photo"><img src={asset(l.img)} alt={l.alt} loading="lazy" /></div>
          <div class="t"><h3>{l.title}</h3><p>{l.text}</p></div>
        </article>
      ))}
    </div>
    <RailHint total={life.length} />
    <p class="life-more"><a class="link" href={link('events/')}>Усі події клубу →</a></p>
  </div>
</section>

<style is:global>
  .life-more { margin: 32px 0 0; }
  .life-read { margin: 0 0 clamp(40px, 5vw, 64px); padding-top: 0; border-top: 0; align-items: start; }
  .life { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .life article { background: var(--bg); display: flex; flex-direction: column; min-width: 0; }
  .life .ph { aspect-ratio: 3/4; border: 0; border-bottom: 1px solid var(--line); }
  .life .t { padding: 18px 18px 22px; display: flex; flex-direction: column; gap: 6px; }
  .life h3 { font-family: var(--display); font-style: italic; font-weight: 800; font-size: 30px; line-height: .95; text-transform: uppercase; }
  .life p { margin: 0; font-size: 14px; color: var(--muted); }
  @media (max-width: 980px) {
    .life > article { flex-basis: min(72%, 300px) !important; }
  }
</style>
