---
// Hand-wrap tape running across the page: the club's motto from the schedule poster.
interface Props { tilt?: number; reverse?: boolean; }
const { tilt = -1.6, reverse = false } = Astro.props;
const words = ['Дисципліна', 'Праця', 'Результат', 'Стань кращою версією себе', 'Світ Боксу', 'Бровари'];
const run = [...words, ...words];
---
<div class="tape-band" style={`--tilt:${tilt}deg`} aria-hidden="true">
  <div class:list={['tape-track', { rev: reverse }]}>
    {[0, 1].map(() => <span class="tape-seq">{run.map((w) => <span>{w}<i></i></span>)}</span>)}
  </div>
</div>

<style is:global>
  .tape-band {
    position: relative; z-index: 2; margin-block: -22px; transform: rotate(var(--tilt));
    background: #f4f4f2; color: #050505; overflow: hidden; width: 104%; margin-left: -2%;
    border-block: 4px solid var(--red); box-shadow: 0 12px 30px rgba(0,0,0,.55);
    background-image: repeating-linear-gradient(90deg, rgba(0,0,0,.035) 0 2px, transparent 2px 7px);
  }
  .tape-track { display: flex; width: max-content; animation: tapeRun 60s linear infinite; }
  .tape-track.rev { animation-direction: reverse; }
  .tape-seq { display: flex; }
  .tape-seq > span {
    display: inline-flex; align-items: center; gap: 28px; padding: 12px 0 10px 28px; white-space: nowrap;
    font-family: var(--display); font-style: italic; font-weight: 900; font-size: clamp(22px, 2.4vw, 34px); text-transform: uppercase; line-height: 1;
  }
  .tape-seq i { width: 12px; height: 12px; background: var(--red); transform: rotate(45deg); }
  @keyframes tapeRun { to { transform: translateX(-50%); } }
</style>
