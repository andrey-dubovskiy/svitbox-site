---
// Sticky sign-up bar on phones. Hidden on the first screen and over the footer,
// where the page already shows the same buttons.
import { site } from '../data/site';
---
<div class="mbar" id="mbar">
  <a class="btn" href="#signup"><span>Записатись</span></a>
  <a class="msg" href={site.messengers.telegram} aria-label="Telegram-канал клубу">TG</a>
</div>

<style is:global>
  .mbar { display: none; }
  @media (max-width: 980px) {
    .mbar {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; gap: 8px;
      padding: 10px max(16px, env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(16px, env(safe-area-inset-left, 0px));
      background: rgba(5,5,5,.94); border-top: 1px solid var(--line);
      transform: translateY(110%); transition: transform .35s var(--ease-out);
    }
    .mbar.show { transform: none; }
    .mbar .btn { flex: 1; height: 50px; justify-content: center; padding: 0 16px; }
    .mbar .msg { height: 50px; width: 50px; display: grid; place-items: center; border: 1px solid var(--line); font-family: var(--mono); font-size: 12px; }
  }
</style>

<script>
  const bar = document.getElementById('mbar')!;
  const hero = document.querySelector('.hero, .page-head');
  const foot = document.querySelector('footer.sf');
  const signup = document.getElementById('signup');
  if (!signup) bar.remove(); // pages without the form (thank-you, policy) need no sign-up bar
  const seen = new Map<Element, boolean>();
  const io = new IntersectionObserver((es) => {
    es.forEach((e) => seen.set(e.target, e.isIntersecting));
    bar.classList.toggle('show', ![...seen.values()].some(Boolean));
  }, { threshold: .05 });
  [hero, foot, signup].forEach((el) => el && io.observe(el));
</script>
