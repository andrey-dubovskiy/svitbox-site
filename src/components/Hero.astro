---
// First screen: club name inside a boxing ring. The ropes are interactive (canvas physics).
import { site } from '../data/site';
import SiteHeader from './SiteHeader.astro';
import { asset } from '../lib/util';
const letters = [...site.name];
---
<div class="hero" id="top">
  <div class="hero-bg" aria-hidden="true"><img id="heroImg" src={asset('img/hero.webp')} srcset={`${asset('img/hero-960.webp')} 960w, ${asset('img/hero.webp')} 1920w`} sizes="100vw" alt="" fetchpriority="high" /></div>
  <canvas id="ring" aria-hidden="true"></canvas>
  <div class="flash" id="flash"></div>
  <div class="hero-inner">
    <SiteHeader home />

    <section class="hero-center wrap" aria-label="Світ Боксу — бокс у Броварах">
      <div class="tags mono"><span class="sq" aria-hidden="true"></span><span>[ Бровари ]</span><span>[ 120+ боксерів ]</span><span>[ since 2012 ]</span></div>
      <p class="word" id="word">
        <span class="sr-only">{site.name}</span>
        {letters.map((c) => (c === ' ' ? <span class="sp" aria-hidden="true"></span> : <span class="ch" aria-hidden="true">{c}</span>))}
      </p>
      <h1 class="sub">Бокс у Броварах — <em>новий спосіб життя</em></h1>
      <div class="ctas">
        <a class="btn" href="#signup"><span>Записатись на тренування</span><span class="arr">→</span></a>
        <a class="link" href="#programs">Обрати програму</a>
      </div>
    </section>

    <div class="hint wrap mono" aria-hidden="true">
      <span>[ Торкнись канатів. Клікни — це удар ]</span>
      <span>Ударів: <span class="count" id="hits">000</span></span>
    </div>
  </div>
</div>

<style is:global>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); isolation: isolate; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; background: var(--bg); }
  .hero-bg img {
    position: absolute; inset: -4%; width: 108%; height: 108%; max-width: none;
    object-fit: cover; object-position: center 40%;
    filter: var(--grade) brightness(.48);
    transform: translate3d(var(--px, 0), var(--py, 0), 0) scale(1.04);
    animation: breathe 24s ease-in-out infinite alternate;
  }
  .hero-bg::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(5,5,5,.55) 0%, rgba(5,5,5,.15) 35%, rgba(5,5,5,.35) 70%, var(--bg) 100%);
  }
  @keyframes breathe { to { scale: 1.07; } }
  #ring { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; cursor: crosshair; touch-action: pan-y; }
  .flash {
    position: absolute; inset: 0; z-index: 1; pointer-events: none; opacity: 0;
    background: radial-gradient(circle at var(--fx, 50%) var(--fy, 50%), rgba(255,41,54,.35), transparent 40%);
  }
  .hero-inner { position: relative; z-index: 2; pointer-events: none; display: flex; flex-direction: column; min-height: min(900px, 100svh); }
  .hero-inner a, .hero-inner button { pointer-events: auto; }


  .hero-center { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 18px; padding-block: 40px 32px; }
  .tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 22px; align-items: center; }
  .word {
    font-family: var(--display); font-style: italic; font-weight: 900;
    font-size: clamp(56px, 18vw, 300px); line-height: .84; letter-spacing: -.015em;
    text-transform: uppercase; white-space: nowrap; margin: 6px 0 0; user-select: none;
  }
  .word .ch { display: inline-block; will-change: transform; }
  .word .sp { display: inline-block; width: .22em; }
  .sub { font-family: var(--serif); font-weight: 400; font-size: clamp(22px, 2.4vw, 34px); line-height: 1.25; max-width: 22ch; }
  /* Dark halo keeps the subtitle readable where a rope or the photo passes behind it */
  .sub { text-shadow: 0 0 3px #050505, 0 0 14px rgba(5,5,5,.95), 0 2px 28px rgba(5,5,5,.9); }
  .sub em { font-style: italic; color: var(--fg); }
  .ctas { display: flex; flex-wrap: wrap; gap: 16px 32px; align-items: center; justify-content: center; margin-top: 14px; }
  .hint { display: flex; justify-content: space-between; gap: 16px; padding-block: 18px; color: var(--muted); }
  .hint .count { color: var(--fg); font-variant-numeric: tabular-nums; }


  @media (max-width: 980px) {
    /* Title in the upper part, ropes stretched across the empty lower part */
    .hero-center { justify-content: flex-start; padding-block: 9vh 32px; gap: 16px; }
    .word { font-size: clamp(64px, 19vw, 180px); }
    .ctas { flex-direction: column; gap: 6px; width: 100%; max-width: 360px; }
    .ctas .btn { width: 100%; justify-content: center; }
  }
  @media (max-width: 560px) {
    .tags { font-size: 11px; gap: 6px 12px; }
    .hint { flex-direction: column; gap: 4px; font-size: 11px; }
  }
</style>

<script>
  import { reduce } from '../scripts/motion';

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const cv = document.getElementById('ring') as HTMLCanvasElement;
  const ctx = cv.getContext('2d')!;
  const flash = document.getElementById('flash')!;
  const hitsEl = document.getElementById('hits')!;
  const heroImg = document.getElementById('heroImg')!;
  const chars = [...document.querySelectorAll<HTMLElement>('#word .ch')];

  // Letters rise in on load
  if (!reduce) chars.forEach((c, i) => c.animate(
    [{ transform: 'translateY(40%) skewX(-12deg)', opacity: 0 }, { transform: 'none', opacity: 1 }],
    { duration: 700, delay: 120 + i * 55, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'backwards' }));

  // ---- Ring ropes: verlet strings pinned at both ends ----
  type Pt = { x: number; y: number; px: number; py: number };
  type Rope = { y: number; color: string; w: number; pts: Pt[]; len: number };
  const N = 46;
  // On narrow screens the title sits higher, so the ropes go lower and stay off the text
  const narrow = () => innerWidth <= 980;
  // On desktop the red rope crosses the title (by design); the white ones go under the subtitle and
  // under the buttons, measured from the layout so they never run through the text.
  const ropeY = () => {
    if (narrow()) return [.72, .8, .88];
    const top = hero.getBoundingClientRect().top;
    const sub = document.querySelector('.hero .sub')?.getBoundingClientRect();
    const cta = document.querySelector('.hero .ctas')?.getBoundingClientRect();
    if (!sub || !cta || !H) return [.50, .63, .76];
    const y2 = Math.min(sub.bottom - top + 14, cta.top - top - 10) / H;
    const y3 = Math.min(cta.bottom - top + 28, H - 24) / H;
    return [.50, y2, Math.max(y3, y2 + .04)];
  };
  const spec = [
    { y: .50, color: '#ff2936', w: 7 },
    { y: .63, color: '#e8e8e4', w: 6 },
    { y: .76, color: '#e8e8e4', w: 6 },
  ];
  let W = 0, H = 0, ropes: Rope[] = [], waves: { x: number; y: number; r: number; a: number }[] = [], hits = 0, running = true;

  function build() {
    const r = hero.getBoundingClientRect();
    const dpr = Math.min(2, window.devicePixelRatio || 1);
    W = r.width; H = r.height;
    cv.width = W * dpr; cv.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const ys = ropeY();
    ropes = spec.map((s, k) => {
      const pts: Pt[] = [];
      for (let i = 0; i < N; i++) {
        const x = -30 + (W + 60) * i / (N - 1), y = H * ys[k];
        pts.push({ x, y, px: x, py: y });
      }
      return { ...s, pts, len: (W + 60) / (N - 1) * .992 };
    });
  }
  function step() {
    for (const r of ropes) {
      const p = r.pts;
      for (let i = 1; i < N - 1; i++) {
        const q = p[i];
        const vx = (q.x - q.px) * .986, vy = (q.y - q.py) * .986;
        q.px = q.x; q.py = q.y; q.x += vx; q.y += vy + .015;
      }
      for (let k = 0; k < 16; k++) {
        for (let i = 0; i < N - 1; i++) {
          const a = p[i], b = p[i + 1];
          const dx = b.x - a.x, dy = b.y - a.y, d = Math.hypot(dx, dy) || 1;
          const diff = (d - r.len) / d * .5, ox = dx * diff, oy = dy * diff;
          if (i !== 0) { a.x += ox; a.y += oy; }
          if (i + 1 !== N - 1) { b.x -= ox; b.y -= oy; }
        }
      }
    }
  }
  function strokeRope(p: Pt[], w: number, color: string, off: number) {
    ctx.beginPath();
    ctx.moveTo(p[0].x, p[0].y + off);
    for (let i = 1; i < N - 1; i++) {
      const mx = (p[i].x + p[i + 1].x) / 2, my = (p[i].y + p[i + 1].y) / 2 + off;
      ctx.quadraticCurveTo(p[i].x, p[i].y + off, mx, my);
    }
    ctx.lineTo(p[N - 1].x, p[N - 1].y + off);
    ctx.lineWidth = w; ctx.strokeStyle = color; ctx.lineCap = 'round'; ctx.stroke();
  }
  function draw() {
    ctx.clearRect(0, 0, W, H);
    for (const wv of waves) {
      ctx.beginPath(); ctx.arc(wv.x, wv.y, wv.r, 0, Math.PI * 2);
      ctx.lineWidth = 2; ctx.strokeStyle = `rgba(255,41,54,${wv.a})`; ctx.stroke();
      ctx.beginPath(); ctx.arc(wv.x, wv.y, wv.r * .6, 0, Math.PI * 2);
      ctx.lineWidth = 1; ctx.strokeStyle = `rgba(244,244,242,${wv.a * .5})`; ctx.stroke();
    }
    for (const r of ropes) {
      strokeRope(r.pts, r.w + 2, 'rgba(0,0,0,.65)', 6);
      strokeRope(r.pts, r.w, r.color, 0);
      strokeRope(r.pts, 1.5, 'rgba(255,255,255,.35)', -r.w * .25);
    }
  }
  function loop() {
    if (running) {
      step();
      waves = waves.filter((w) => (w.r += 9, w.a -= .025) > 0);
      draw();
    }
    requestAnimationFrame(loop);
  }

  // Brushing the ropes
  let mx: number | null = null, my: number | null = null;
  cv.addEventListener('pointermove', (e) => {
    const r = cv.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
    if (mx !== null && my !== null) {
      const vx = x - mx, vy = y - my;
      for (const rp of ropes) for (const q of rp.pts) {
        const d = Math.hypot(q.x - x, q.y - y);
        if (d < 46) { const f = 1 - d / 46; q.px -= vx * .5 * f; q.py -= vy * .5 * f; }
      }
    }
    mx = x; my = y;
  });
  cv.addEventListener('pointerleave', () => { mx = my = null; });

  // A click is a punch
  cv.addEventListener('pointerdown', (e) => {
    const r = cv.getBoundingClientRect();
    punch(e.clientX - r.left, e.clientY - r.top, e.clientX, e.clientY);
  });
  function punch(x: number, y: number, cx: number, cy: number) {
    hits++; hitsEl.textContent = String(hits).padStart(3, '0');
    for (const rp of ropes) for (const q of rp.pts) {
      const dx = q.x - x, dy = q.y - y, d = Math.hypot(dx, dy) || 1;
      if (d < 220) { const f = (1 - d / 220) * 26; q.px -= dx / d * f; q.py -= dy / d * f; }
    }
    waves.push({ x, y, r: 8, a: .9 });
    if (reduce) { draw(); return; }
    flash.style.setProperty('--fx', x + 'px'); flash.style.setProperty('--fy', y + 'px');
    flash.animate([{ opacity: 0 }, { opacity: 1 }, { opacity: 0 }], { duration: 420, easing: 'ease-out' });
    chars.forEach((c) => {
      const b = c.getBoundingClientRect();
      const dx = b.left + b.width / 2 - cx, dy = b.top + b.height / 2 - cy, d = Math.hypot(dx, dy) || 1;
      const amp = Math.max(0, 1 - d / 700) * 34;
      if (amp < 1) return;
      c.animate([
        { transform: 'none' },
        { transform: `translate(${dx / d * amp}px,${dy / d * amp}px) skewX(${-dx / d * 8}deg)`, offset: .25 },
        { transform: 'none' },
      ], { duration: 520, easing: 'cubic-bezier(.2,.8,.2,1)' });
    });
  }

  // Background photo drifts with the mouse
  if (!reduce) hero.addEventListener('pointermove', (e) => {
    const r = hero.getBoundingClientRect();
    heroImg.style.setProperty('--px', ((e.clientX - r.left) / r.width - .5) * -24 + 'px');
    heroImg.style.setProperty('--py', ((e.clientY - r.top) / r.height - .5) * -16 + 'px');
  });

  build(); draw();
  addEventListener('resize', () => { build(); draw(); });
  // Web fonts change the text height: place the ropes again once they are in
  document.fonts?.ready.then(() => { build(); draw(); });
  new IntersectionObserver(([en]) => { running = en.isIntersecting && !reduce; }).observe(hero);
  if (!reduce) requestAnimationFrame(loop);
</script>
