---
// Placeholder for the future background video: a brief for the videographer.
import { videoBrief } from '../data/content';
import RailHint from './RailHint.astro';
---
<section class="blk video-sec" id="video">
  <div class="brief ph">
    <div class="wrap brief-in">
      <div class="brief-head">
        <span class="mono"><span class="brief-dot">●</span> Заглушка · ТЗ для відеографа</span>
        <h2 class="h2" data-punch>Фонове відео</h2>
        <p>Тут буде беззвучна петля на всю ширину екрана: вона грає сама і показує атмосферу залу за 15–20 секунд. Поверх відео стоять заголовок і кнопка, тому важливе те, що в кадрі в центрі і правіше, а лівий нижній кут залиште спокійним.</p>
      </div>
      <div class="brief-grid m-rail">
        {videoBrief.map((b) => (
          <section>
            <h3 class="mono">{b.title}</h3>
            {b.ordered
              ? <ol>{b.items.map((i) => <li>{i}</li>)}</ol>
              : <ul>{b.items.map((i) => <li>{i}</li>)}</ul>}
          </section>
        ))}
      </div>
      <RailHint total={videoBrief.length} />
    </div>
  </div>
</section>

<style is:global>
  section.blk.video-sec { padding-block: 0; }
  .brief { display: block; padding: 0; border-left: 0; border-right: 0; }
  .brief::before, .brief::after { display: none; }
  .brief-dot { color: var(--red); }
  .brief-in { padding-block: clamp(56px, 7vw, 104px); display: flex; flex-direction: column; gap: clamp(32px, 4vw, 56px); }
  .brief-head { display: flex; flex-direction: column; gap: 18px; max-width: 70ch; }
  .brief-head p { margin: 0; color: var(--muted); font-size: 17px; }
  .brief-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .brief-grid section { background: var(--bg); padding: 24px; min-width: 0; }
  .brief-grid h3 { font-size: 12px; color: var(--red); margin: 0 0 14px; font-weight: 500; }
  .brief-grid ul, .brief-grid ol { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 9px; font-size: 15px; line-height: 1.45; }
  .brief-grid li::marker { color: var(--muted); }
  @media (max-width: 980px) {
    .brief-in { gap: 28px; }
    .brief-head p { font-size: 15px; }
    .brief-grid { align-items: flex-start; }
    .brief-grid section { padding: 20px; }
  }
</style>
