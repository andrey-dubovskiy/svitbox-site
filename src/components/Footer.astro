---
// Footer: ring ropes, call to action, link columns, live clocks and a giant name that dodges the cursor.
import { site, socials, halls } from '../data/site';
import { isTodo, link } from '../lib/util';
import { programLinks } from '../data/programs';
const letters = [...site.name];
---
<footer class="sf" id="contacts">
  <div class="sf-ropes" aria-hidden="true"><i></i><i></i><i></i></div>

  <div class="wrap sf-grid">
    <nav aria-label="Програми"><h3 class="mono"><a href={link('programy/')}>Програми</a></h3><ul>
      {programLinks.map((p) => <li><a href={link(p.href)}>{p.label}</a></li>)}
    </ul></nav>
    <nav aria-label="Клуб"><h3 class="mono">Клуб</h3><ul>
      <li><a href={link('about_us/')}>Тренери і зал</a></li><li><a href={link('#champions')}>Чемпіони</a></li><li><a href={link('#life')}>Події клубу</a></li><li><a href={link('#first')}>Перше тренування</a></li>
    </ul></nav>
    <nav aria-label="Сторінки"><h3 class="mono">Сторінки</h3><ul>
      <li><a href={link('rozklad/')}>Розклад</a></li><li><a href={link('tsiny/')}>Ціни</a></li><li><a href={link('kontakty/')}>Контакти</a></li><li><a href={link('polityka/')}>Політика конфіденційності</a></li>
    </ul></nav>
    <div><h3 class="mono">Зал</h3><ul>
      <li><a class="sf-tel" href={`tel:${site.phone.tel}`}>{site.phone.display}</a></li>
      {halls.map((h) => <li><a href={link('kontakty/#' + h.id)}>{h.address}</a></li>)}
      <li class="muted">{site.hours[0]}</li>
      <li class="muted">У Броварах зараз <b class="sf-live" id="sfTime">--:--</b></li>
    </ul></div>
    <nav aria-label="Соцмережі"><h3 class="mono">Соцмережі</h3><ul>
      {socials.map((s) => (
        <li>
          {s.href === '#'
            ? <span class="muted">{s.label} <span class="todo">{s.note}</span></span>
            : <a href={s.href} target="_blank" rel="noopener">{s.label} <span aria-hidden="true">↗</span></a>}
        </li>
      ))}
    </ul></nav>
    <div class="sf-clock"><h3 class="mono">Ти на сайті</h3>
      <div class="sf-round mono">Раунд <b id="sfRound">1</b></div>
      <div class="sf-tick" id="sfTick">00:00</div>
      <div class="sf-tbar"><i id="sfTbar"></i></div>
    </div>
  </div>

  <div class="sf-word" id="sfWord" aria-hidden="true">
    {letters.map((c) => (c === ' ' ? <span class="gap"></span> : <span class="l">{c}</span>))}
  </div>

  <div class="wrap sf-bottom mono">
    <span>© 2012–2026 Світ Боксу · Бровари</span>
    <span class="muted">Фото: клуб «Світ Боксу». Окремі фото — Unsplash, тимчасово</span>
    <a href="#top" class="sf-up">Нагору <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style is:global>
  .sf-tel { font-family: var(--display); font-style: italic; font-weight: 800; font-size: 26px; line-height: 1; }
  .sf-tel:hover { color: var(--red); }
  .sf-ropes + .sf-grid { border-top: 0; }
  footer.sf { position: relative; overflow: hidden; background: var(--bg); }
  .sf-ropes { display: flex; flex-direction: column; gap: 14px; padding-block: 44px 0; }
  .sf-ropes i { display: block; height: 5px; background: #e8e8e4; box-shadow: 0 5px 0 rgba(0,0,0,.6); }
  .sf-ropes i:first-child { background: var(--red); }
  .sf:hover .sf-ropes i { animation: sway 1.6s ease-in-out infinite alternate; }
  .sf:hover .sf-ropes i:nth-child(2) { animation-delay: .15s; }
  .sf:hover .sf-ropes i:nth-child(3) { animation-delay: .3s; }
  @keyframes sway { to { transform: translateY(3px) scaleX(1.002); } }


  .sf-grid { display: grid; grid-template-columns: 1.3fr repeat(5, minmax(0, 1fr)); gap: 32px; padding-block: 48px; }
  .sf-grid h3 a::after { display: none; }
  @media (max-width: 1240px) { .sf-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .sf-grid h3 { font-size: 12px; color: var(--red); font-weight: 500; margin: 0 0 16px; }
  .sf-grid ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px; }
  .sf-grid a { position: relative; }
  .sf-grid a::after { content: ""; position: absolute; left: 0; right: 100%; bottom: -2px; height: 1px; background: var(--red); transition: right .3s var(--ease-io); }
  .sf-grid a:hover::after { right: 0; }
  .sf-live { font-weight: 500; color: var(--fg); font-variant-numeric: tabular-nums; }
  .sf-clock { border: 1px solid var(--line); padding: 16px; display: flex; flex-direction: column; gap: 8px; align-self: start; }
  .sf-clock h3 { margin-bottom: 4px; }
  .sf-round b { color: var(--red); font-weight: 500; }
  .sf-tick { font-family: var(--display); font-style: italic; font-weight: 900; font-size: 52px; line-height: .9; font-variant-numeric: tabular-nums; }
  .sf-tbar { height: 3px; background: var(--surface); position: relative; }
  .sf-tbar i { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--red); }

  .sf-word { font-family: var(--display); font-style: italic; font-weight: 900; font-size: 19vw;
    padding-inline: max(var(--gx), 4vw); line-height: .84; text-transform: uppercase; white-space: nowrap; text-align: center; height: .7em; overflow: hidden; letter-spacing: -.02em; user-select: none; margin-top: 8px; cursor: default; }
  .sf-word .l { display: inline-block; will-change: transform; transition: color .3s; }
  .sf-word .l.hit { color: var(--red); }
  .sf-word .gap { display: inline-block; width: .18em; }
  .sf-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; padding-block: 20px 28px; border-top: 1px solid var(--line); font-size: 12px; position: relative; background: var(--bg); }
  .sf-up:hover { color: var(--red); }

  @media (max-width: 980px) {
    .sf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sf-clock { grid-column: 1 / -1; }
  }
</style>

<script>
  import { reduce } from '../scripts/motion';
  import { thud } from '../scripts/sound';

  const foot = document.querySelector<HTMLElement>('footer.sf')!;
  const word = document.getElementById('sfWord')!;

  // Size the giant name to fill the width between the side margins exactly
  function fitWord() {
    word.style.fontSize = '100px';
    const cs = getComputedStyle(word);
    const avail = word.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    const range = document.createRange(); range.selectNodeContents(word);
    const textW = range.getBoundingClientRect().width;
    if (textW > 0) word.style.fontSize = (100 * avail / textW * .985).toFixed(2) + 'px';
  }
  fitWord();
  document.fonts?.ready.then(fitWord);
  addEventListener('resize', fitWord);
  const board = document.getElementById('board');
  const letters = [...document.querySelectorAll<HTMLElement>('#sfWord .l')].map((el) => ({ el, y: 0, r: 0, ty: 0, tr: 0 }));
  let visible = false, cursorX: number | null = null;

  foot.addEventListener('pointermove', (e) => { cursorX = e.clientX; });
  foot.addEventListener('pointerleave', () => { cursorX = null; });

  // Letters slip away from the cursor, like a boxer dodging a punch
  (function dodge() {
    if (visible && !reduce) {
      letters.forEach((o) => {
        if (cursorX === null) { o.ty = 0; o.tr = 0; }
        else {
          const b = o.el.getBoundingClientRect(), d = b.left + b.width / 2 - cursorX, k = Math.max(0, 1 - Math.abs(d) / 260);
          o.ty = -k * 22; o.tr = Math.sign(d || 1) * k * 7;
        }
        o.y += (o.ty - o.y) * .16; o.r += (o.tr - o.r) * .16;
        o.el.style.transform = `translateY(${o.y.toFixed(2)}%) rotate(${o.r.toFixed(2)}deg)`;
      });
    }
    requestAnimationFrame(dodge);
  })();

  // A click on a letter is a hit
  letters.forEach((o) => o.el.addEventListener('pointerdown', () => {
    o.el.classList.add('hit'); setTimeout(() => o.el.classList.remove('hit'), 380);
    thud(300);
    if (!reduce) o.el.animate([{ translate: '0 0' }, { translate: '0 6%' }, { translate: '-2% -2%' }, { translate: '0 0' }], { duration: 300, easing: 'ease-out' });
  }));

  new IntersectionObserver(([en]) => {
    visible = en.isIntersecting;
    board?.classList.toggle('off', en.isIntersecting); // hide the scoreboard over the footer
    if (en.isIntersecting && !reduce && !foot.dataset.seen) {
      foot.dataset.seen = '1';
      letters.forEach((o, i) => o.el.animate([{ translate: '0 60%' }, { translate: '0 0' }], { duration: 700, delay: i * 45, easing: 'cubic-bezier(.2,.8,.2,1)' }));
    }
  }, { threshold: .15 }).observe(foot);

  // Local time in Brovary and the visitor's "rounds" on the site
  const sfTime = document.getElementById('sfTime')!, sfRound = document.getElementById('sfRound')!;
  const sfTick = document.getElementById('sfTick')!, sfTbar = document.getElementById('sfTbar')!;
  const kyiv = new Intl.DateTimeFormat('uk-UA', { timeZone: 'Europe/Kyiv', hour: '2-digit', minute: '2-digit' });
  const t0 = Date.now();
  function tick() {
    try { sfTime.textContent = kyiv.format(new Date()); } catch { /* no timezone data */ }
    const el = Math.floor((Date.now() - t0) / 1000), inR = el % 180;
    sfRound.textContent = String(Math.floor(el / 180) + 1);
    sfTick.textContent = String(Math.floor(inR / 60)).padStart(2, '0') + ':' + String(inR % 60).padStart(2, '0');
    sfTbar.style.width = (inR / 180 * 100) + '%';
  }
  tick(); setInterval(tick, 1000);

</script>
