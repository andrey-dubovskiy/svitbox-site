---
// Round 01: programs list. Hovering a row shows its photo next to the cursor.
import RoundLabel from './RoundLabel.astro';
import { programs } from '../data/content';
import { asset } from '../lib/util';
---
<section class="blk" id="programs">
  <div class="wrap">
    <RoundLabel n="Раунд 01" label="Програми" />
    <div class="progs" id="progs">
      <div class="follow ph photo" id="follow" aria-hidden="true"><img id="followImg" src={asset(programs[0].img)} alt="" /></div>
      {programs.map((p) => (
        <a class="prog" href="#signup" data-p={p.signup} data-img={asset(p.img)}>
          <img class="prog-thumb" src={asset(p.img)} alt="" loading="lazy" />
          <span class="name" data-punch>{p.name}</span>
          <p>{p.text}</p>
          <span class="go" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .progs { border-top: 1px solid var(--line); position: relative; }
  .prog {
    position: relative; z-index: 1; display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr) auto; gap: 24px; align-items: center;
    padding-block: 28px; border-bottom: 1px solid var(--line); transition: color .25s;
  }
  .prog .name {
    font-family: var(--display); font-style: italic; font-weight: 800;
    font-size: clamp(40px, 5.6vw, 84px); line-height: .9; text-transform: uppercase;
    transition: transform .35s var(--ease-io);
  }
  .prog p { margin: 0; max-width: 44ch; color: var(--muted); }
  .prog .go {
    width: 56px; height: 56px; border: 1px solid var(--line); display: grid; place-items: center;
    transition: background .25s, border-color .25s, transform .35s;
  }
  @media (hover: hover) {
    .prog:hover .name { transform: translateX(18px); color: var(--red); }
    .prog:hover .go { background: var(--fg); border-color: var(--fg); color: var(--bg); transform: rotate(-45deg); }
    .prog:hover p { color: var(--fg); }
  }
  .prog:active .name { color: var(--red); }
  .progs .follow {
    position: absolute; left: 0; top: 0; width: 260px; aspect-ratio: 4/5; max-width: 100%;
    pointer-events: none; z-index: 3; opacity: 0;
    transform: translate(-50%, -50%) scale(.85); transition: opacity .25s, transform .25s;
  }
  .progs .follow.on { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  .progs .follow img { filter: grayscale(.2) contrast(1.05); }
  .prog-thumb { display: none; }
  @media (max-width: 980px) {
    /* No hover on phones: each row gets its own photo */
    .prog { grid-template-columns: 88px minmax(0, 1fr) auto; gap: 8px 16px; padding-block: 18px; align-items: start; }
    .prog-thumb {
      display: block; grid-row: 1 / span 2; width: 88px; height: 110px; object-fit: cover;
      filter: grayscale(1) contrast(1.08); border: 1px solid var(--line);
    }
    .prog .name { font-size: clamp(30px, 8.6vw, 52px); align-self: end; }
    .prog p { grid-column: 2 / -1; grid-row: 2; font-size: 15px; }
    .prog .go { width: 44px; height: 44px; grid-column: 3; grid-row: 1; }
    .progs .follow { display: none; }
  }
</style>

<script>
  const follow = document.getElementById('follow')!;
  const fImg = document.getElementById('followImg') as HTMLImageElement;
  const progs = document.getElementById('progs')!;
  let fx = 0, fy = 0, tx = 0, ty = 0, chasing = false;

  document.querySelectorAll<HTMLElement>('.prog').forEach((row) => {
    new Image().src = row.dataset.img!;
    row.addEventListener('mouseenter', () => {
      fImg.src = row.dataset.img!; follow.classList.add('on');
      if (!chasing) { chasing = true; requestAnimationFrame(chase); }
    });
    row.addEventListener('mouseleave', () => follow.classList.remove('on'));
    row.addEventListener('mousemove', (e) => {
      const r = progs.getBoundingClientRect(), half = follow.offsetWidth / 2, x = e.clientX - r.left;
      tx = x + 40 + 2 * half > r.width ? x - 40 - half : x + 40 + half;
      ty = Math.min(Math.max(e.clientY - r.top, follow.offsetHeight / 2), r.height - follow.offsetHeight / 2);
    });
    // Picking a program preselects it in the sign-up form
    row.addEventListener('click', () => {
      const radio = document.getElementById('p-' + row.dataset.p) as HTMLInputElement | null;
      if (radio) radio.checked = true;
    });
  });

  // The photo eases toward the cursor; the loop stops once it has settled and is hidden
  function chase() {
    fx += (tx - fx) * .16; fy += (ty - fy) * .16;
    follow.style.left = fx + 'px'; follow.style.top = fy + 'px';
    const settled = Math.abs(tx - fx) < .5 && Math.abs(ty - fy) < .5;
    if (settled && !follow.classList.contains('on')) { chasing = false; return; }
    requestAnimationFrame(chase);
  }
</script>
