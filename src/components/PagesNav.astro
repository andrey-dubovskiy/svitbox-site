---
// Big links to the separate pages: schedule, prices, directions.
import { pages } from '../data/site';
import { link } from '../lib/util';
interface Props { current?: string; }
const list = pages.filter((p) => p.href !== Astro.props.current);
---
<nav class="pages" aria-label="Корисні сторінки">
  {list.map((p) => (
    <a href={link(p.href)}><b>{p.label} <span aria-hidden="true">→</span></b><span>{p.text}</span></a>
  ))}
</nav>

<style is:global>
  .pages { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .pages a { padding: 36px clamp(16px, 2.5vw, 40px); display: flex; flex-direction: column; gap: 10px; border-right: 1px solid var(--line); transition: background var(--t) var(--ease-out), color var(--t) var(--ease-out); min-width: 0; }
  .pages a:last-child { border-right: 0; }
  .pages a b { font-family: var(--display); font-style: italic; font-weight: 900; font-size: clamp(36px, 4vw, 60px); line-height: .9; text-transform: uppercase; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .pages a > span { color: var(--muted); font-size: 15px; }
  .pages a:hover { background: var(--fg); color: var(--bg); }
  .pages a:hover > span { color: #3a3a37; }
  @media (max-width: 980px) {
    .pages { grid-template-columns: minmax(0, 1fr); }
    .pages a { border-right: 0; border-bottom: 1px solid var(--line); }
    .pages a:last-child { border-bottom: 0; }
  }
</style>
