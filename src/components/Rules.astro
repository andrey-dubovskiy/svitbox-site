---
// Before the first training: medical certificate, kit, payment, how long a pass lasts.
import RoundLabel from './RoundLabel.astro';
import { rules } from '../data/schedule';
interface Props { n: string; only?: string[]; title?: string; }
const list = Astro.props.only ? rules.filter((r) => Astro.props.only!.includes(r.icon)) : rules;
// Line icons, drawn for this site
const icons: Record<string, string> = {
  doc: '<rect x="10" y="6" width="28" height="36" rx="2"/><path d="M18 6v-2h12v2"/><path d="M24 16v12M18 22h12" stroke="var(--red)"/><path d="M16 34h16"/>',
  bag: '<path d="M6 18h36l-3 22H9z"/><path d="M17 18v-5a7 7 0 0 1 14 0v5"/><path d="M6 26h36" stroke="var(--red)"/>',
  card: '<rect x="5" y="12" width="38" height="26" rx="3"/><path d="M5 19h38" stroke="var(--red)" stroke-width="4"/><path d="M11 31h10"/>',
  cal: '<rect x="6" y="10" width="36" height="32" rx="2"/><path d="M6 19h36M15 6v8M33 6v8"/><rect x="13" y="25" width="7" height="7" fill="var(--red)" stroke="none"/>',
};
---
<section class="blk">
  <div class="wrap">
    <RoundLabel n={Astro.props.n} label="Важливо знати" />
    <h2 class="h2" data-punch>{Astro.props.title ?? 'Перед першим тренуванням'}</h2>
    <ol class="rules m-rail">
      {list.map((r, i) => (
        <li><span class="rule-top"><svg class="rule-ico" viewBox="0 0 48 48" aria-hidden="true" set:html={icons[r.icon]} /><span class="mono">{String(i + 1).padStart(2, '0')}</span></span><b>{r.title}</b><p class="muted">{r.text}</p></li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  .rules { list-style: none; margin: clamp(32px, 4vw, 56px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .rules li { padding: 28px 24px 32px 0; border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 12px; }
  .rules li + li { padding-left: 24px; }
  .rules li:last-child { border-right: 0; }
  .rules .mono { color: var(--red); }
  .rule-top { display: flex; justify-content: space-between; align-items: flex-start; }
  .rule-ico { width: 48px; height: 48px; fill: none; stroke: var(--fg); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform var(--t) var(--ease-out); }
  .rules li:hover .rule-ico { transform: rotate(-8deg) scale(1.08); }
  .rules b { font-family: var(--display); font-style: italic; font-weight: 800; text-transform: uppercase; font-size: clamp(26px, 2.4vw, 36px); line-height: .95; }
  .rules p { margin: 0; }
  @media (max-width: 980px) {
    .rules li, .rules li + li { padding: 22px; }
  }
</style>
