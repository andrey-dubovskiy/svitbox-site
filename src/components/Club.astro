---
// Round 02: the club in numbers.
import RoundLabel from './RoundLabel.astro';
import { clubStats, clubAbout } from '../data/content';
import { asset } from '../lib/util';
---
<section class="blk" id="club">
  <div class="wrap">
    <RoundLabel n="Раунд 02" label="Клуб" />
    <div class="club">
      <div>
        <h2 class="h2" data-punch>Один з найсильніших залів Броварів</h2>
        <div class="club-ph ph photo reveal"><img src={asset('img/club/komanda-08-dity-z-medaliamy-v-zali.webp')} alt="Зал клубу «Світ Боксу» в СК «Манеж»: ринг з логотипом клубу, діти з медалями й тренери" style="object-position:50% 55%" loading="lazy" /></div>
      </div>
      <div class="club-side">
        <p class="lead">Індивідуальні програми, графік тренувань і харчування під кожного. <em>Від першого заняття до рингу на міжнародному турнірі.</em></p>
        <div class="stats">
          {clubStats.map((s) => (
            <div class="stat">
              {s.plus
                ? <span class="v"><span data-to={s.value}>{s.value}</span><sup>+</sup></span>
                : <span class="v" data-to={s.value}>{s.value}</span>}
              <span class="l">{s.label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="club-read">
      <div>
        <h2 class="read-h2">{clubAbout.h2}</h2>
        <p class="read-intro">{clubAbout.intro}</p>
      </div>
      <div>
        <h3 class="read-h3"><span class="sq"></span> {clubAbout.h3}</h3>
        {clubAbout.text.map((t) => <p class="read-p">{t}</p>)}
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Long read under a section (old-site copy kept for search) */
  .club-read { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 32px clamp(32px, 6vw, 96px); margin-top: clamp(56px, 7vw, 104px); padding-top: clamp(40px, 5vw, 64px); border-top: 1px solid var(--line); }
  .read-h2 { font-family: var(--display); font-style: italic; font-weight: 900; font-size: clamp(36px, 3.6vw, 60px); line-height: .92; text-transform: uppercase; max-width: 16ch; }
  .read-intro { font-family: var(--serif); font-size: clamp(19px, 1.6vw, 23px); line-height: 1.45; color: var(--muted); margin: 24px 0 0; max-width: 34em; }
  .read-h3 { font-family: var(--mono); font-weight: 400; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--red); display: flex; align-items: center; gap: 12px; margin: 0 0 18px; }
  .read-p { font-family: var(--serif); font-size: clamp(17px, 1.3vw, 19px); line-height: 1.6; margin: 0 0 16px; max-width: 38em; }
  @media (max-width: 980px) { .club-read { grid-template-columns: minmax(0, 1fr); } }

  .club { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  .club-side { display: flex; flex-direction: column; gap: 40px; min-width: 0; }
  .lead { font-family: var(--serif); font-size: clamp(24px, 2.5vw, 36px); line-height: 1.3; margin: 0; }
  .lead em { color: var(--muted); }
  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .stat { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 24px 22px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .stat .v { font-family: var(--display); font-style: italic; font-weight: 900; font-size: clamp(56px, 6vw, 92px); line-height: .9; font-variant-numeric: tabular-nums; }
  .stat .v sup { font-size: .45em; color: var(--red); vertical-align: top; position: relative; top: .15em; }
  .stat .l { font-size: 15px; color: var(--muted); }
  .club-ph { margin-top: 28px; aspect-ratio: 16/9; }
  @media (max-width: 980px) { .club { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) { .stats { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  import { reduce, countTo } from '../scripts/motion';
  // Numbers count up when they scroll into view. Counters below the first screen
  // start from their low value right away, so the number does not flick back before counting.
  if (!reduce) {
    const startOf = (to: number) => (to > 1000 ? to - 40 : 0);
    const io = new IntersectionObserver((es) => es.forEach((en) => {
      if (!en.isIntersecting) return;
      io.unobserve(en.target);
      const el = en.target as HTMLElement, to = +el.dataset.to!;
      countTo(el, startOf(to), to, 1400);
    }), { threshold: .6 });
    document.querySelectorAll<HTMLElement>('#club [data-to]').forEach((c) => {
      if (c.getBoundingClientRect().top > innerHeight) {
        c.textContent = String(startOf(+c.dataset.to!));
        io.observe(c);
      }
    });
  }
</script>
