---
// Between rounds: a punching bag with pendulum physics and a playful "punch power" meter.
import RoundLabel from './RoundLabel.astro';
---
<section class="blk bag-sec" id="bag">
  <div class="wrap bag-grid">
    <div class="bag-stage">
      <canvas id="bagCv" aria-hidden="true"></canvas>
      <span class="mono muted bag-hint">[ Клікни по груші. Що швидше рука, то сильніший удар ]</span>
    </div>
    <div class="bag-info">
      <RoundLabel n="Між раундами" label="Груша" flush />
      <h2 class="h2" data-punch>Перевір свій удар</h2>
      <div class="meter" aria-live="polite">
        <span class="mono muted">Сила удару</span>
        <div class="kg"><span id="kg">000</span><small>кг</small></div>
        <div class="bar"><i id="kgBar"></i></div>
        <div class="meter-row mono"><span id="rank">Розминка</span><span>Рекорд: <b id="best">000</b> кг</span></div>
      </div>
      <div class="bag-actions">
        <button class="btn" type="button" id="punchBtn"><span>Вдарити</span><span class="arr">→</span></button>
        <a class="link" href="#signup">Поставити удар у залі</a>
      </div>
      <p class="muted bag-note">Це гра, а не вимірювання. Справжню силу удару тренер поставить і заміряє в залі.</p>
    </div>
  </div>
</section>

<style is:global>
  .bag-sec { overflow: hidden; }
  .bag-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .bag-stage { position: relative; height: 640px; min-width: 0; }
  #bagCv { position: absolute; inset: 0; width: 100%; height: 100%; cursor: crosshair; touch-action: manipulation; }
  .bag-hint { position: absolute; left: 0; right: 0; bottom: 24px; text-align: center; pointer-events: none; }
  .bag-info { display: flex; flex-direction: column; gap: 28px; padding-block: clamp(56px, 7vw, 96px); min-width: 0; }
  .meter { border: 1px solid var(--line); padding: 24px; display: flex; flex-direction: column; gap: 12px; max-width: 520px; }
  .kg { display: flex; align-items: baseline; gap: 10px; }
  .kg span { font-family: var(--display); font-style: italic; font-weight: 900; font-size: clamp(88px, 9vw, 140px); line-height: .85; font-variant-numeric: tabular-nums; }
  .kg small { font-family: var(--mono); font-size: 16px; color: var(--muted); }
  .bar { height: 6px; background: var(--surface); position: relative; overflow: hidden; }
  .bar i { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--red); transition: width .5s var(--ease-out); }
  .meter-row { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .meter-row b { font-weight: 500; color: var(--fg); }
  #rank { color: var(--fg); }
  .bag-actions { display: flex; flex-wrap: wrap; gap: 16px 28px; align-items: center; }
  .bag-note { margin: 0; font-size: 14px; max-width: 44ch; }
  @media (max-width: 980px) {
    .bag-grid { grid-template-columns: minmax(0, 1fr); }
    .bag-stage { height: 480px; order: 2; }
    .bag-info { padding-bottom: 0; }
  }
</style>

<script>
  import { reduce } from '../scripts/motion';
  import { thud } from '../scripts/sound';

  const bcv = document.getElementById('bagCv') as HTMLCanvasElement;
  const bx = bcv.getContext('2d')!;
  const stage = bcv.parentElement!;
  const kgEl = document.getElementById('kg')!, kgBar = document.getElementById('kgBar')!;
  const bestEl = document.getElementById('best')!, rankEl = document.getElementById('rank')!;

  const CHAIN = 140, BAGL = 400, BAGW = 172;
  let BW = 0, BH = 0, theta = 0, omega = 0, squash = 0, bagOn = true, best = 0;
  let rings: { x: number; y: number; r: number; a: number }[] = [];
  let dents: { x: number; y: number; a: number }[] = [];

  try { best = +(localStorage.getItem('sbx-best') || 0); } catch { /* storage blocked */ }
  bestEl.textContent = String(best).padStart(3, '0');

  const scale = () => Math.min(1, BH / 620);

  function bsize() {
    const r = stage.getBoundingClientRect(), d = Math.min(2, devicePixelRatio || 1);
    BW = r.width; BH = r.height; bcv.width = BW * d; bcv.height = BH * d; bx.setTransform(d, 0, 0, d, 0, 0);
  }

  function bagDraw() {
    bx.clearRect(0, 0, BW, BH);
    const px = BW / 2, sc = scale();
    // floor shadow follows the swing
    const sx = px + Math.sin(theta) * (CHAIN + BAGL) * sc;
    bx.fillStyle = 'rgba(0,0,0,.6)';
    bx.beginPath(); bx.ellipse(sx, BH - 40, BAGW * .7 * sc, 10 * sc, 0, 0, Math.PI * 2); bx.fill();

    bx.save(); bx.translate(px, 0); bx.rotate(-theta); bx.scale(sc, sc);
    // chains and hook
    bx.strokeStyle = '#8a8a86'; bx.lineWidth = 2;
    [-BAGW / 2 + 10, -BAGW / 6, BAGW / 6, BAGW / 2 - 10].forEach((x) => { bx.beginPath(); bx.moveTo(0, 18); bx.lineTo(x, CHAIN); bx.stroke(); });
    bx.fillStyle = '#d0d0cc'; bx.beginPath(); bx.arc(0, 14, 7, 0, Math.PI * 2); bx.fill();
    bx.fillStyle = '#2a2a28'; bx.fillRect(-4, 0, 8, 12);
    // leather body, squashes on impact
    const w = BAGW * (1 + squash), h = BAGL * (1 - squash * .35), top = CHAIN;
    const g = bx.createLinearGradient(-w / 2, 0, w / 2, 0);
    g.addColorStop(0, '#060606'); g.addColorStop(.3, '#2b2b29'); g.addColorStop(.45, '#3a3a37'); g.addColorStop(.7, '#151514'); g.addColorStop(1, '#040404');
    bx.fillStyle = g;
    bx.beginPath(); bx.roundRect(-w / 2, top, w, h, [14, 14, 26, 26]); bx.fill();
    bx.fillStyle = 'rgba(244,244,242,.08)'; bx.fillRect(-w / 2, top + 18, w, 6); bx.fillRect(-w / 2, top + h - 30, w, 6);
    // red band with the club name
    bx.fillStyle = '#ff2936'; bx.fillRect(-w / 2, top + h * .38, w, 54);
    bx.fillStyle = 'rgba(0,0,0,.25)'; bx.fillRect(w * .18, top + h * .38, w * .32, 54);
    bx.fillStyle = '#f4f4f2'; bx.font = 'italic 900 30px "Fira Sans Extra Condensed", Impact, sans-serif';
    bx.textAlign = 'center'; bx.textBaseline = 'middle';
    bx.fillText('СВІТ БОКСУ', 0, top + h * .38 + 28);
    // fading dents where it was hit
    dents.forEach((d) => { bx.fillStyle = `rgba(0,0,0,${d.a * .55})`; bx.beginPath(); bx.ellipse(d.x, top + d.y, 20 * d.a + 6, 26 * d.a + 8, 0, 0, Math.PI * 2); bx.fill(); });
    bx.fillStyle = 'rgba(255,255,255,.05)'; bx.fillRect(-w * .2, top + 10, w * .08, h - 20);
    bx.restore();
    rings.forEach((r) => { bx.strokeStyle = `rgba(255,41,54,${r.a})`; bx.lineWidth = 2; bx.beginPath(); bx.arc(r.x, r.y, r.r, 0, Math.PI * 2); bx.stroke(); });
  }

  function bagStep() {
    omega += -.0024 * Math.sin(theta) - .011 * omega; // damped pendulum
    theta += omega;
    squash *= .82;
    rings = rings.filter((r) => (r.r += 7, r.a -= .04) > 0);
    dents = dents.filter((d) => (d.a -= .02) > 0);
  }

  (function bagLoop() { if (bagOn) { bagStep(); bagDraw(); } requestAnimationFrame(bagLoop); })();
  new IntersectionObserver(([en]) => { bagOn = en.isIntersecting; }).observe(stage);
  bsize(); bagDraw();
  addEventListener('resize', () => { bsize(); bagDraw(); });
  document.fonts?.ready.then(bagDraw);

  // Hand speed before the click sets the "power"
  let trail: { x: number; y: number; t: number }[] = [];
  bcv.addEventListener('pointermove', (e) => {
    const t = performance.now();
    trail.push({ x: e.clientX, y: e.clientY, t });
    trail = trail.filter((p) => t - p.t < 90);
  });

  const rankOf = (kg: number) => kg < 200 ? 'Розминка' : kg < 350 ? 'Аматор' : kg < 500 ? 'Розрядник' : kg < 650 ? 'Майстер спорту' : 'Чемпіон світу';
  let shown = 0;
  function showKg(kg: number) {
    const from = shown, t0 = performance.now(); shown = kg;
    kgBar.style.width = Math.min(100, kg / 800 * 100) + '%';
    rankEl.textContent = rankOf(kg);
    if (kg > best) {
      best = kg; bestEl.textContent = String(best).padStart(3, '0');
      try { localStorage.setItem('sbx-best', String(best)); } catch { /* storage blocked */ }
    }
    if (reduce) { kgEl.textContent = String(kg).padStart(3, '0'); return; }
    (function f(t: number) {
      const k = Math.min(1, (t - t0) / 500), v = Math.round(from + (kg - from) * (1 - Math.pow(1 - k, 3)));
      kgEl.textContent = String(v).padStart(3, '0');
      if (k < 1) requestAnimationFrame(f);
    })(t0);
  }

  function hit(localX: number, localY: number, cx: number, cy: number, speed: number) {
    const kg = Math.round(Math.min(800, 140 + speed * 190 + Math.random() * 60));
    const dir = localX < 0 ? 1 : -1;
    omega += dir * kg / 26000;
    squash = Math.min(.12, kg / 5000);
    dents.push({ x: localX, y: Math.max(40, Math.min(BAGL - 40, localY - CHAIN)), a: 1 });
    rings.push({ x: cx, y: cy, r: 10, a: .9 });
    showKg(kg); thud(kg);
    if (!reduce) stage.animate([{ transform: 'translate(0,0)' }, { transform: `translate(${dir * 4}px,2px)` }, { transform: 'translate(0,0)' }], { duration: 180 });
  }

  bcv.addEventListener('pointerdown', (e) => {
    const r = bcv.getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top, sc = scale();
    const dx = x - BW / 2, dy = y, c = Math.cos(theta), s = Math.sin(theta);
    const lx = (dx * c - dy * s) / sc, ly = (dx * s + dy * c) / sc; // into bag space
    if (ly < CHAIN || ly > CHAIN + BAGL || Math.abs(lx) > BAGW / 2 + 10) return;
    let speed = 0;
    if (trail.length > 1) {
      const a = trail[0], b = trail[trail.length - 1];
      speed = Math.hypot(b.x - a.x, b.y - a.y) / Math.max(16, b.t - a.t);
    }
    if (e.pointerType !== 'mouse') speed = .6 + Math.random() * 1.6;
    hit(lx, ly, x, y, speed);
  });

  document.getElementById('punchBtn')!.addEventListener('click', () => {
    const sc = scale(), side = Math.random() < .5 ? -1 : 1;
    const lx = side * BAGW * .3, ly = CHAIN + BAGL * .45;
    hit(lx, ly, BW / 2 + lx * sc, ly * sc, .8 + Math.random() * 1.8);
  });
</script>
